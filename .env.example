# PrestaShop Webservice (catalog). Leave blank to use the built-in mock catalog.
PRESTASHOP_API_URL=https://shop.example.com/api
PRESTASHOP_API_KEY=YOUR_WEBSERVICE_KEY

# Public shop URL used to build product image URLs.
PUBLIC_SHOP_URL=https://shop.example.com

# Customer auth endpoint (custom PrestaShop module exposing /login, /register).
# Leave blank to use the built-in demo account (any email + password "demo1234").
PRESTASHOP_AUTH_URL=https://shop.example.com/api/auth

# Storefront locale + currency (Intl formatting).
PUBLIC_LOCALE=en-IE
PUBLIC_CURRENCY=EUR
