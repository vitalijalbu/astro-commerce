---
/**
 * Contact form section. Built entirely from WebCoreUI form components
 * (<Input>, <Textarea>, <Button>). Submits client-side for the template —
 * wire to your support inbox / PrestaShop contact endpoint.
 */
import { Input, Textarea, Button } from 'webcoreui/astro'
import Section from '../snippets/section.astro'
import SectionHeading from '../snippets/section-heading.astro'
import { shop } from '../../lib/navigation'
import type { ContactSection } from '../../lib/sections'

interface Props {
    section: ContactSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
        <div>
            <SectionHeading heading={s.heading} subheading={s.text} align="left" />
            <div class="flex flex-col gap-2 text-sm text-ink-soft">
                <a href={`mailto:${shop.email}`} class="link-underline self-start">{shop.email}</a>
                <span>Mon–Fri, 9:00–17:00 CET</span>
            </div>
        </div>

        <form data-contact class="flex flex-col gap-4">
            <div class="grid sm:grid-cols-2 gap-4">
                <Input name="name" label="Name" required {...{ autocomplete: 'name' }} />
                <Input type="email" name="email" label="Email" required {...{ autocomplete: 'email' }} />
            </div>
            <Input name="subject" label="Subject" />
            <Textarea name="message" label="Message" rows={5} required />
            <div class="flex items-center gap-3">
                <Button type="submit">Send message</Button>
                <span data-contact-success hidden class="text-sm text-accent">Thanks — we'll be in touch soon.</span>
            </div>
        </form>
    </div>
</Section>

<script>
    document.querySelector('[data-contact]')?.addEventListener('submit', e => {
        e.preventDefault()
        const form = e.currentTarget as HTMLFormElement
        // TODO: POST to your contact endpoint.
        form.reset()
        form.querySelector<HTMLElement>('[data-contact-success]')?.removeAttribute('hidden')
    })
</script>
