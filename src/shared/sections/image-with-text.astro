---
import { Image } from 'astro:assets'
import type { ImageWithTextSection } from '@lib/sections'
import Section from '@snippets/section.astro'
import { parseImgDimensions } from '@utils/images'

interface Props {
    section: ImageWithTextSection
}

const { section } = Astro.props
const s = section.settings
const imageRight = s.imageSide === 'right'
const imgSize = parseImgDimensions(s.image) ?? { width: 900, height: 1125 }
---

<Section spacing="lg" background={section.background} id={section.id}>
    <div class="grid md:grid-cols-2 gap-8 md:gap-14 items-center">
        <div class:list={['overflow-hidden rounded-lg bg-paper-soft', imageRight && 'md:order-2']}>
            <Image
                src={s.image}
                alt={s.heading}
                width={imgSize.width}
                height={imgSize.height}
                loading="lazy"
                class="w-full h-full object-cover aspect-[4/5]"
            />
        </div>
        <div class="flex flex-col gap-4 items-start">
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h2 class="text-2xl md:text-4xl font-semibold tracking-tight m-0">{s.heading}</h2>
            <p class="text-lg text-ink-soft m-0">{s.text}</p>
            {s.cta && <a href={s.cta.href} class="btn mt-2" data-variant="secondary">{s.cta.label}</a>}
        </div>
    </div>
</Section>
