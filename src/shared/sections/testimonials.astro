---
import type { TestimonialsSection } from '@lib/sections'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'
import { Card } from '@/components/ui/card'
import { CardContent } from '@/components/ui/card/card-content.astro'
import { Rating } from '@/components/ui/rating'

interface Props {
    section: TestimonialsSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    {s.heading && <SectionHeading heading={s.heading} align="center" />}
    <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        {s.items.map(item => (
            <Card size="sm" class="border-border">
                <CardContent>
                    {item.rating && <Rating value={item.rating} />}
                    <blockquote class="text-lg leading-relaxed my-4">"“{item.quote}”</blockquote>
                    <footer class="text-sm">
                        <span class="font-semibold">{item.author}</span>
                        {item.role && <span class="text-muted-foreground"> · {item.role}</span>}
                    </footer>
                </CardContent>
            </Card>
        ))}
    </div>
</Section>
