---
import type { CollageSection } from '@lib/sections'
/**
 * Editorial collage — one large tile + stacked small tiles (Dawn "collage").
 */
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'

interface Props {
    section: CollageSection
}

const { section } = Astro.props
const s = section.settings
const large = s.tiles.find(t => t.size === 'large') ?? s.tiles[0]
const small = s.tiles.filter(t => t !== large)
---

<Section spacing="md" background={section.background} id={section.id}>
    {s.heading && <SectionHeading heading={s.heading} subheading={s.subheading} align="left" />}
    <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <a href={large.href} class="group relative block overflow-hidden rounded-[--radius-card] bg-paper-soft">
            <img src={large.image} alt={large.title} loading="lazy"
                class="w-full h-full object-cover aspect-[4/5] md:aspect-auto md:min-h-[520px] transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <span class="absolute bottom-0 left-0 p-6 text-white text-2xl font-semibold">{large.title}</span>
        </a>
        <div class="grid gap-4 md:gap-6">
            {small.map(tile => (
                <a href={tile.href} class="group relative block overflow-hidden rounded-[--radius-card] bg-paper-soft">
                    <img src={tile.image} alt={tile.title} loading="lazy"
                        class="w-full h-full object-cover aspect-[16/10] md:min-h-[248px] transition-transform duration-500 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <span class="absolute bottom-0 left-0 p-5 text-white text-xl font-semibold">{tile.title}</span>
                </a>
            ))}
        </div>
    </div>
</Section>
