---
/**
 * Featured product collection — grid or fulldev/ui <Carousel>. The heading
 * renders immediately; the products are a deferred server island so the page
 * shell paints without waiting on the catalog fetch (a skeleton grid holds the
 * space until the real products stream in).
 */
import type { FeaturedCollectionSection } from '@lib/sections'
import FeaturedCollectionProducts from '@sections/featured-collection-products.astro'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'
import SkeletonProductGrid from '@snippets/skeleton-product-grid.astro'

interface Props {
    section: FeaturedCollectionSection
}

const { section } = Astro.props
const s = section.settings
const isCarousel = s.layout === 'carousel'
const limit = s.limit ?? 4
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="left" cta={s.cta} />

    <FeaturedCollectionProducts
        collectionHandle={s.collectionHandle ?? 'all'}
        limit={limit}
        layout={isCarousel ? 'carousel' : 'grid'}
        ariaLabel={s.heading}
        server:defer
    >
        <SkeletonProductGrid slot="fallback" count={limit} columns={4} />
    </FeaturedCollectionProducts>
</Section>
