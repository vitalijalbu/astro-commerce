---
/**
 * Featured product collection — grid or fulldev/ui <Carousel>. Products are
 * fetched server-side from the catalog (PrestaShop, with mock fallback).
 */
import { getCollectionProducts } from '@lib/catalog'
import type { FeaturedCollectionSection } from '@lib/sections'
import ProductCard from '@snippets/product-card.astro'
import ProductCarousel from '@snippets/product-carousel.astro'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'

interface Props {
    section: FeaturedCollectionSection
}

const { section } = Astro.props
const s = section.settings
const products = await getCollectionProducts(s.collectionHandle ?? 'all', s.limit ?? 4)
const isCarousel = s.layout === 'carousel'
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="left" cta={s.cta} />

    {isCarousel ? (
        <ProductCarousel products={products} ariaLabel={s.heading} />
    ) : (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {products.map((product, i) => (
                <ProductCard product={product} eager={i < 4} />
            ))}
        </div>
    )}
</Section>
