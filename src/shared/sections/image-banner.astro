---
import type { ImageBannerSection } from '@lib/sections'
import { parseImgDimensions } from '@utils/images'
import { Image } from 'astro:assets'

interface Props {
    section: ImageBannerSection
}

const { section } = Astro.props
const s = section.settings
const imgSize = parseImgDimensions(s.image) ?? { width: 2000, height: 1100 }

const height = {
    medium: 'min-h-[420px]',
    large: 'min-h-[560px] md:min-h-[680px]',
    full: 'min-h-[calc(100vh-7rem)]'
}[s.height ?? 'large']

const align = {
    left: 'items-start text-left',
    center: 'items-center text-center',
    right: 'items-end text-right'
}[s.align ?? 'left']
---

<section class:list={['relative w-full flex', height]}>
    <div class="absolute inset-0 overflow-hidden">
        <Image
            src={s.image}
            alt={s.heading}
            width={imgSize.width}
            height={imgSize.height}
            loading="eager"
            class="h-full w-full object-cover"
        />
    </div>
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="page relative z-10 flex flex-col justify-center w-full">
        <div class:list={['flex flex-col gap-4 max-w-xl text-white', align]}>
            {s.subheading && (
                <span class="eyebrow !text-white/80">{s.subheading}</span>
            )}
            <h1 class="text-4xl md:text-6xl font-semibold tracking-tight m-0">{s.heading}</h1>
            {s.text && <p class="text-lg text-white/90 m-0">{s.text}</p>}
            <div class="flex flex-wrap gap-3 mt-2">
                {s.primaryCta && <a href={s.primaryCta.href} class="btn">{s.primaryCta.label}</a>}
                {s.secondaryCta && (
                    <a href={s.secondaryCta.href} class="btn text-white border-white hover:text-white hover:bg-white/20" data-variant="secondary">
                        {s.secondaryCta.label}
                    </a>
                )}
            </div>
        </div>
    </div>
</section>
