---
/**
 * Centered rich-text block — eyebrow, heading, paragraph and optional CTA.
 */
import { Button } from 'webcoreui/astro'
import type { RichTextSection } from '@lib/sections'
import Section from '@snippets/section.astro'

interface Props {
    section: RichTextSection
}

const { section } = Astro.props
const s = section.settings
const align = s.align === 'left' ? 'items-start text-left' : 'items-center text-center mx-auto'
---

<Section spacing="md" background={section.background} id={section.id}>
    <div class:list={['flex flex-col gap-4 max-w-2xl', align]}>
        {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
        <h2 class="text-2xl md:text-4xl font-semibold tracking-tight m-0">{s.heading}</h2>
        <p class="text-lg text-ink-soft m-0" set:html={s.text} />
        {s.cta && <Button href={s.cta.href} className="mt-2">{s.cta.label}</Button>}
    </div>
</Section>
