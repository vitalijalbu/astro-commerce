---
import type { CollectionListSection } from '@lib/sections'
import CollectionListItems from '@sections/collection-list-items.astro'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'


interface Props {
    section: CollectionListSection
}

const { section } = Astro.props
const s = section.settings
const columns = s.columns ?? 3

const cols = {
    2: 'sm:grid-cols-2',
    3: 'sm:grid-cols-2 lg:grid-cols-3',
    4: 'grid-cols-2 lg:grid-cols-4'
}[columns]
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="left" />

    <CollectionListItems handles={s.handles} columns={columns} server:defer>
        <div slot="fallback" class:list={['grid gap-4 md:gap-6', cols]} aria-hidden="true">
            {Array.from({ length: s.handles?.length || columns }).map(() => (
                <div class="aspect-[3/4] overflow-hidden rounded-[--radius-card]">
                    <div class="skeleton w-full h-full"></div>
                </div>
            ))}
        </div>
    </CollectionListItems>
</Section>
