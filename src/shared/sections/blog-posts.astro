---
/**
 * Latest journal/blog posts as image cards.
 */
import Section from '../snippets/section.astro'
import SectionHeading from '../snippets/section-heading.astro'
import BlogCard from '../snippets/blog-card.astro'
import type { BlogPostsSection } from '../../lib/sections'

interface Props {
    section: BlogPostsSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="left"
        cta={{ label: 'All articles', href: '/blog' }} />
    <ul role="list" class="grid md:grid-cols-3 gap-6 md:gap-8">
        {s.posts.map(post => (
            <li>
                <BlogCard post={post} showButton={false} />
            </li>
        ))}
    </ul>
</Section>
