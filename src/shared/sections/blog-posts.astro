---
/**
 * Latest journal/blog posts as image cards.
 */
import Section from '../snippets/section.astro'
import SectionHeading from '../snippets/section-heading.astro'
import type { BlogPostsSection } from '../../lib/sections'

interface Props {
    section: BlogPostsSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="left"
        cta={{ label: 'All articles', href: '/blog' }} />
    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        {s.posts.map(post => (
            <a href={post.href} class="group block">
                <div class="aspect-[3/2] overflow-hidden rounded-[--radius-card] bg-paper-soft mb-4">
                    <img
                        src={post.image}
                        alt={post.title}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                </div>
                <span class="eyebrow">{post.date}</span>
                <h3 class="text-lg font-semibold mt-1 mb-1.5 link-underline self-start inline-block">{post.title}</h3>
                <p class="text-ink-soft text-sm m-0">{post.excerpt}</p>
            </a>
        ))}
    </div>
</Section>
