---
import type { FaqSection } from '@lib/sections'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'

interface Props {
    section: FaqSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    <div class="max-w-3xl mx-auto">
        <SectionHeading heading={s.heading} subheading={s.subheading} align="center" />
        {s.items.map(item => (
            <details class="accordion">
                <summary>{item.title}</summary>
                <p>{item.content}</p>
            </details>
        ))}
    </div>
</Section>
