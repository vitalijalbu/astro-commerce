---
import { Image } from 'astro:assets'
import type { BrandLogosSection } from '@lib/sections'
import Section from '@snippets/section.astro'
import SectionHeading from '@snippets/section-heading.astro'
import brandPlaceholder from '../../assets/brand-placeholder.png'

interface Props {
    section: BrandLogosSection
}

const { section } = Astro.props
const s = section.settings
---

<Section spacing="md" background={section.background} id={section.id}>
    <SectionHeading heading={s.heading} subheading={s.subheading} align="center" />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        {s.brands.map(brand => {
            const content = (
                <div class="flex h-full min-h-28 flex-col items-center justify-center gap-3 rounded-[--radius-card] border border-line bg-paper px-4 py-6 text-center transition hover:border-line-strong hover:bg-paper-soft">
                    <Image src={brandPlaceholder} alt={`${brand.name} logo`} width={120} height={48} class="h-10 w-auto object-contain opacity-80" />
                    <span class="aspect-[3/2]font-medium text-ink-soft">{brand.name}</span>
                </div>
            )

            return brand.href ? <a href={brand.href}>{content}</a> : content
        })}
    </div>
</Section>