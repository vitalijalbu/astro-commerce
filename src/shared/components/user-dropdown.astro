---
import type { AuthUser } from '@lib/auth'
import Icon from '@snippets/icon.astro'

interface Props {
    user: AuthUser
}

const { user } = Astro.props
const label = user.name || user.firstName || user.email
const initials = (user.name || user.email)
    .split(/\s+/).slice(0, 2).map(p => p[0]?.toUpperCase() ?? '').join('') || 'U'
---

<div class="dropdown-menu">
    <button
        type="button"
        aria-haspopup="menu"
        aria-expanded="false"
        class="flex items-center gap-2 rounded-full pl-1 pr-2 py-1 hover:bg-paper-soft transition"
    >
        <span class="grid place-items-center w-8 h-8 rounded-full bg-accent-soft text-accent text-xs font-semibold">
            {initials}
        </span>
        <span class="hidden md:inline max-w-24 truncate text-sm font-medium">{label}</span>
        <Icon type="chevron-down" size={14} />
    </button>

    <div data-popover aria-hidden="true" data-align="end" class="mt-2">
        <div role="menu" class="w-60 bg-paper border border-line rounded-[--radius-card] shadow-xl overflow-hidden" aria-label="User menu">
            <div class="p-4 border-b border-line" role="heading" aria-level="2">
                <p class="text-sm font-semibold m-0 truncate">{label}</p>
                <p class="text-xs text-muted m-0 truncate">{user.email}</p>
            </div>
            <a href="/account" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-sm hover:bg-paper-soft transition">
                <Icon type="user" size={16} />
                Overview
            </a>
            <a href="/account/orders" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-sm hover:bg-paper-soft transition">
                <Icon type="cart" size={16} />
                Orders
            </a>
            <a href="/account/profile" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-sm hover:bg-paper-soft transition">
                <Icon type="shield" size={16} />
                Profile
            </a>
            <div role="separator" class="border-t border-line my-0"></div>
            <a href="/logout" role="menuitem" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sale hover:bg-paper-soft transition">
                <Icon type="close" size={16} />
                Sign out
            </a>
        </div>
    </div>
</div>
