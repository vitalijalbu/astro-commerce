---
import type { AuthUser } from '@lib/auth'
import { mainMenu, shop } from '@lib/navigation'
import Icon from '@snippets/icon.astro'

interface Props {
    user: AuthUser | null
}

const { user } = Astro.props

const panels = mainMenu
    .map((item, index) => ({ item, index }))
    .filter(({ item }) => item.columns?.length)
    .map(({ item, index }) => ({
        index,
        label: item.label,
        href: item.href,
        links: item.columns?.flatMap(c => c.items) ?? []
    }))
---

<dialog id="mobile-menu" class="drawer lg:hidden" data-side="left" aria-labelledby="mobile-menu-title">
    <article class="max-w-sm">
        <header>
            <h2 id="mobile-menu-title">{shop.name}</h2>
        </header>
        <section class="px-4">
            <div data-mobile-nav class="relative min-h-0 overflow-x-hidden overflow-y-auto">
                <nav data-panel="root" class="mobile-panel flex flex-col" aria-label="Mobile">
                    {mainMenu.map((item, index) => (
                        item.columns?.length ? (
                            <button
                                type="button"
                                data-open-panel={index}
                                aria-expanded="false"
                                class="flex items-center justify-between gap-2 py-3 text-base font-medium border-b border-line text-left w-full"
                            >
                                {item.label}
                                <Icon type="chevron-right" size={18} />
                            </button>
                        ) : (
                            <a href={item.href} class="block py-3 text-base font-medium border-b border-line">
                                {item.label}
                            </a>
                        )
                    ))}

                    <div class="mt-6 pt-4 border-t border-line flex flex-col gap-1">
                        {user ? (
                            <>
                                <a href="/account" class="py-2 text-sm font-medium">My account</a>
                                <a href="/account/orders" class="py-2 text-sm text-ink-soft">Orders</a>
                                <a href="/wishlist" class="py-2 text-sm text-ink-soft">Wishlist</a>
                                <a href="/logout" class="py-2 text-sm text-sale">Sign out</a>
                            </>
                        ) : (
                            <>
                                <a href="/login" class="py-2 text-sm font-medium">Sign in</a>
                                <a href="/register" class="py-2 text-sm text-ink-soft">Create account</a>
                                <a href="/wishlist" class="py-2 text-sm text-ink-soft">Wishlist</a>
                            </>
                        )}
                        <a href={`mailto:${shop.email}`} class="py-2 text-sm text-muted-foreground">{shop.email}</a>
                    </div>
                </nav>

                {panels.map(panel => (
                    <nav
                        data-panel={panel.index}
                        class="mobile-panel mobile-panel--child flex flex-col"
                        aria-label={panel.label}
                        aria-hidden="true"
                    >
                        <button
                            type="button"
                            data-close-panel
                            class="flex items-center gap-1.5 py-3 text-sm font-medium text-muted-foreground border-b border-line text-left w-full"
                        >
                            <Icon type="chevron-left" size={18} />
                            Back
                        </button>
                        <a href={panel.href} class="py-3 text-base font-semibold border-b border-line">
                            All {panel.label}
                        </a>
                        {panel.links.map(link => (
                            <a href={link.href} class="py-2.5 text-sm text-ink-soft border-b border-line/60">
                                {link.label}
                            </a>
                        ))}
                    </nav>
                ))}
            </div>
        </section>
    </article>
</dialog>

<script>
    import { closeDrawer, initDrawerCancel, initDrawerBackdrop } from '@utils/dom'

    const initMobileNav = () => {
        const nav = document.querySelector<HTMLElement>('[data-mobile-nav]')
        if (!nav || nav.dataset.bound === 'true') return
        nav.dataset.bound = 'true'

        const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu')
        if (!dialog) return

        const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]')
        if (toggle) {
            toggle.addEventListener('click', () => {
                if (dialog.hasAttribute('open')) {
                    closeDrawer(dialog)
                } else {
                    dialog.showModal()
                }
            })
        }

        initDrawerCancel(dialog)
        initDrawerBackdrop(dialog)

        const closeAll = () => {
            nav.querySelectorAll('.mobile-panel--child.is-active').forEach(p => p.classList.remove('is-active'))
            nav.querySelectorAll('[data-open-panel]').forEach(b => b.setAttribute('aria-expanded', 'false'))
        }

        nav.addEventListener('click', e => {
            const opener = (e.target as HTMLElement).closest<HTMLElement>('[data-open-panel]')
            if (opener) {
                nav.querySelector(`[data-panel="${opener.dataset.openPanel}"]`)?.classList.add('is-active')
                opener.setAttribute('aria-expanded', 'true')
                return
            }
            const closer = (e.target as HTMLElement).closest<HTMLElement>('[data-close-panel]')
            if (closer) closer.closest('.mobile-panel--child')?.classList.remove('is-active')
        })

        dialog.addEventListener('close', () => {
            const trigger = document.querySelector<HTMLElement>('[data-menu-toggle]')
            trigger?.setAttribute('aria-expanded', 'false')
            trigger?.focus()
            closeAll()
        })
    }

    initMobileNav()
    document.addEventListener('astro:after-swap', initMobileNav)
</script>
