---
import { shop } from '@lib/navigation'

const messages = shop.announcements
---

<div
    class="bg-brand text-brand-contrast text-center text-xs tracking-wide relative"
    data-announcement
>
    <div class="page flex items-center justify-center gap-2 h-9">
        <p data-announcement-text class="m-0">{messages[0]}</p>
    </div>
    <button
        type="button"
        data-announcement-close
        aria-label="Dismiss announcement"
        class="btn absolute right-3 top-1/2 -translate-y-1/2 text-white/70 hover:text-white"
        data-variant="ghost"
        data-size="icon-sm"
    >×</button>
</div>

<script is:inline define:vars={{ messages }}>
    const bar = document.querySelector('[data-announcement]')
    if (bar) {
        if (sessionStorage.getItem('announcement-dismissed')) {
            bar.remove()
        } else {
            const textEl = bar.querySelector('[data-announcement-text]')
            let index = 0
            if (messages.length > 1) {
                setInterval(() => {
                    index = (index + 1) % messages.length
                    textEl.style.opacity = '0'
                    setTimeout(() => {
                        textEl.textContent = messages[index]
                        textEl.style.opacity = '1'
                    }, 250)
                }, 4000)
                textEl.style.transition = 'opacity .25s ease'
            }
            bar.querySelector('[data-announcement-close]')?.addEventListener('click', () => {
                sessionStorage.setItem('announcement-dismissed', '1')
                bar.remove()
            })
        }
    }
</script>
