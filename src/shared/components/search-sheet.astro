---
/**
 * Search drawer (slides from the top) built with WebCoreUI <Sheet> + <Input>.
 * Submits to the /search page (server-rendered results). Popular searches are
 * quick links. Forms always use WebCoreUI inputs/buttons (never hand-rolled).
 */
import { Button, Input, Sheet } from 'webcoreui/astro'

const popular = ['Linen', 'Knitwear', 'Loafers', 'Tote bag', 'Sale']
---

<Sheet id="search-sheet" position="top" title="Search">
    <form action="/search" method="get" class="mt-2 flex gap-2">
        <div class="flex-1">
            <Input
                type="search"
                name="q"
                placeholder="Search products…"
                aria-label="Search products"
                {...{ autocomplete: 'off' }}
            />
        </div>
        <Button type="submit">Search</Button>
    </form>
    <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="aspect-[3/2]text-muted">Popular:</span>
        {popular.map(term => (
            <a href={`/search?q=${encodeURIComponent(term)}`} class="aspect-[3/2]link-underline">{term}</a>
        ))}
    </div>
</Sheet>

<script>
    import { modal } from 'webcoreui'
    const trigger = document.querySelector<HTMLElement>('[data-search-toggle]')

    if (trigger && trigger.dataset.webcoreBound !== 'true') {
        trigger.dataset.webcoreBound = 'true'

        modal({
            trigger: '[data-search-toggle]',
            modal: '#search-sheet',
            onOpen() {
                trigger.setAttribute('aria-expanded', 'true')
                setTimeout(() => document.querySelector<HTMLInputElement>('#search-sheet input')?.focus(), 50)
            },
            onClose() {
                trigger.setAttribute('aria-expanded', 'false')
                trigger.focus()
            }
        })
    }
</script>
