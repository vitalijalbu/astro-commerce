---
const popular = ['Linen', 'Knitwear', 'Loafers', 'Tote bag', 'Sale']
---

<dialog id="search-sheet" class="drawer" data-side="top" aria-labelledby="search-sheet-title">
    <article>
        <header>
            <h2 id="search-sheet-title">Search</h2>
        </header>
        <section class="px-4">
            <form action="/search" method="get" class="flex gap-2">
                <div class="flex-1">
                    <input
                        class="input w-full"
                        type="search"
                        name="q"
                        placeholder="Search products…"
                        aria-label="Search products"
                        autocomplete="off"
                    />
                </div>
                <button type="submit" class="btn">Search</button>
            </form>
            <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="text-sm text-muted-foreground">Popular:</span>
                {popular.map(term => (
                    <a href={`/search?q=${encodeURIComponent(term)}`} class="text-sm link-underline">{term}</a>
                ))}
            </div>
        </section>
    </article>
</dialog>

<script>
    const trigger = document.querySelector<HTMLElement>('[data-search-toggle]')
    const dialog = document.querySelector<HTMLDialogElement>('#search-sheet')

    if (trigger && dialog) {
        trigger.addEventListener('click', () => dialog.showModal())

        dialog.addEventListener('close', () => {
            trigger.setAttribute('aria-expanded', 'false')
            trigger.focus()
        })

        dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close()
        })
    }
</script>
