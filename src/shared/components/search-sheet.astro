---
/**
 * Search drawer (slides from the top) built with WebCoreUI <Sheet> + <Input>.
 * Submits to the /search page (server-rendered results). Popular searches are
 * quick links. Forms always use WebCoreUI inputs/buttons (never hand-rolled).
 */
import { Sheet, Input, Button } from 'webcoreui/react'

const popular = ['Linen', 'Knitwear', 'Loafers', 'Tote bag', 'Sale']
---

<Sheet id="search-sheet" position="top" title="Search">
    <form action="/search" method="get" class="mt-2 flex gap-2">
        <div class="flex-1">
            <Input
                type="search"
                name="q"
                placeholder="Search products…"
                aria-label="Search products"
                autoComplete="off"
            />
        </div>
        <Button type="submit">Search</Button>
    </form>
    <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-sm text-muted">Popular:</span>
        {popular.map(term => (
            <a href={`/search?q=${encodeURIComponent(term)}`} class="text-sm link-underline">{term}</a>
        ))}
    </div>
</Sheet>

<script>
    import { modal } from 'webcoreui'
    modal({ trigger: '[data-search-toggle]', modal: '#search-sheet' })
    // Focus the field when the sheet opens.
    document.querySelector('[data-search-toggle]')?.addEventListener('click', () => {
        setTimeout(() => document.querySelector<HTMLInputElement>('#search-sheet input')?.focus(), 50)
    })
</script>
