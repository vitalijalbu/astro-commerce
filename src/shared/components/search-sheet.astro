---
const popular = ['Linen', 'Knitwear', 'Loafers', 'Tote bag', 'Sale']
---

<dialog id="search-sheet" class="drawer" data-side="top" aria-labelledby="search-sheet-title">
    <article>
        <header>
            <h2 id="search-sheet-title">Search</h2>
            <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close search" onclick="this.closest('dialog').close()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </header>
        <section class="px-4">
            <form action="/search" method="get" class="flex gap-2">
                <div class="flex-1">
                    <input
                        class="input w-full"
                        type="search"
                        name="q"
                        placeholder="Search products…"
                        aria-label="Search products"
                        autocomplete="off"
                    />
                </div>
                <button type="submit" class="btn">Search</button>
            </form>
            <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="text-sm text-muted-foreground">Popular:</span>
                {popular.map(term => (
                    <a href={`/search?q=${encodeURIComponent(term)}`} class="text-sm link-underline">{term}</a>
                ))}
            </div>
        </section>
    </article>
</dialog>

<script>
    import { initDrawerCancel, initDrawerBackdrop } from '@utils/dom'

    const initSearchSheet = () => {
        const trigger = document.querySelector<HTMLElement>('[data-search-toggle]')
        const dialog = document.querySelector<HTMLDialogElement>('#search-sheet')

        if (!trigger || !dialog) return

        initDrawerCancel(dialog)
        initDrawerBackdrop(dialog)

        if (trigger.dataset.bound !== 'true') {
            trigger.dataset.bound = 'true'
            trigger.addEventListener('click', () => dialog.showModal())
        }

        dialog.addEventListener('close', () => {
            trigger.setAttribute('aria-expanded', 'false')
            trigger.focus()
        })
    }

    initSearchSheet()
    document.addEventListener('astro:after-swap', initSearchSheet)
</script>
