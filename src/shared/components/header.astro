---
import type { AuthUser } from '@lib/auth'
import { mainMenu, shop } from '@lib/navigation'
import Icon from '@snippets/icon.astro'
import UserDropdown from './user-dropdown.astro'

interface Props {
    user: AuthUser | null
}

const { user } = Astro.props
---

<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur border-b border-line" role="banner">
    <div class="page flex items-center justify-between h-16 md:h-20 gap-4">
        <!-- Left: mobile menu + nav -->
        <div class="flex items-center gap-2 flex-1 min-w-0">
            <button
                type="button"
                data-menu-toggle
                aria-label="Open menu"
                aria-haspopup="dialog"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="lg:hidden p-2 -ml-2"
            >
                <Icon type="menu" size={22} />
            </button>

            <nav class="hidden lg:flex items-stretch gap-1" aria-label="Primary">
                {mainMenu.map(item => (
                    <div class="has-menu relative flex items-center">
                        <a
                            href={item.href}
                            class="text-sm font-medium px-3 h-20 inline-flex items-center gap-1.5 hover:text-accent transition"
                            aria-haspopup={item.columns ? 'menu' : undefined}
                        >
                            {item.label}
                            {item.badge && (
                                <span class="text-[10px] font-semibold uppercase tracking-wide bg-accent-soft text-accent rounded-full px-1.5 py-0.5">
                                    {item.badge}
                                </span>
                            )}
                            {item.columns && <Icon type="chevron-down" size={13} />}
                        </a>

                        {item.columns && (
                            <div class="menu-panel absolute left-0 top-full z-50">
                                <div class="flex gap-8 bg-paper border border-line rounded-[--radius-card] shadow-xl p-6 min-w-[640px]">
                                    <div class="flex gap-10 flex-1">
                                        {item.columns.map(col => (
                                            <div class="min-w-40">
                                                <p class="eyebrow mb-3">{col.title}</p>
                                                <ul class="flex flex-col gap-2 list-none p-0 m-0" aria-label={col.title}>
                                                    {col.items.map(link => (
                                                        <li>
                                                            <a href={link.href} class="text-sm text-ink-soft hover:text-ink link-underline">
                                                                {link.label}
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>
                                    {item.promo && (
                                        <a href={item.promo.href} class="group relative w-56 shrink-0 overflow-hidden rounded-[--radius-card]">
                                            <img src={item.promo.image} alt={item.promo.title} class="w-full h-full object-cover aspect-[4/5] transition-transform duration-500 group-hover:scale-105" />
                                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                            <div class="absolute bottom-0 left-0 p-4 text-white">
                                                {item.promo.eyebrow && <span class="eyebrow !text-white/80">{item.promo.eyebrow}</span>}
                                                <p class="font-semibold leading-tight m-0 mt-1">{item.promo.title}</p>
                                                {item.promo.cta && <span class="text-sm mt-1 inline-block link-underline">{item.promo.cta} →</span>}
                                            </div>
                                        </a>
                                    )}
                                </div>
                            </div>
                        )}
                    </div>
                ))}
            </nav>
        </div>

        <!-- Center: logo -->
        <a href="/" class="text-xl md:text-2xl font-semibold tracking-[0.25em] shrink-0">
            {shop.name}
        </a>

        <!-- Right: utilities -->
        <div class="flex items-center justify-end gap-1 flex-1">
            <button
                type="button"
                data-search-toggle
                aria-label="Search"
                aria-haspopup="dialog"
                aria-controls="search-sheet"
                aria-expanded="false"
                class="p-2 hover:text-accent transition"
            >
                <Icon type="search" size={20} />
            </button>

            <a href="/wishlist" aria-label="Wishlist" class="relative inline-flex p-2 transition hover:text-accent">
                <Icon type="heart" size={20} />
                <span
                    data-wishlist-count
                    hidden
                    aria-hidden="true"
                    class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 grid place-items-center text-[10px] font-semibold rounded-full bg-accent text-white"
                >0</span>
            </a>

            {user ? (
                <UserDropdown user={user} />
            ) : (
                <a href="/login" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium hover:text-accent transition">
                    <Icon type="user" size={18} />
                    <span class="hidden md:inline">Sign in</span>
                </a>
            )}

            <button
                type="button"
                data-cart-toggle
                aria-label="Open cart"
                aria-haspopup="dialog"
                aria-controls="cart-drawer"
                aria-expanded="false"
                class="btn relative"
                data-variant="ghost"
            >
                <Icon type="cart" size={20} />
                <span
                    data-cart-count
                    hidden
                    aria-hidden="true"
                    class="badge absolute -top-0.5 -right-0.5"
                >0</span>
            </button>
        </div>
    </div>
</header>
