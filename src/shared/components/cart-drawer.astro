---
import SkeletonCartLine from '@snippets/skeleton-cart-line.astro'
---

<dialog id="cart-drawer" class="drawer" data-side="right" aria-labelledby="cart-drawer-title">
    <article class="w-full sm:max-w-md!">
        <header>
            <h2 id="cart-drawer-title">Your cart</h2>
            <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close cart" data-drawer-close="cart-drawer">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </header>
        <section class="px-4 min-h-0 flex-1 overflow-y-auto">
            <ul data-cart-loading class="list-none p-0 m-0">
                <SkeletonCartLine compact />
                <SkeletonCartLine compact />
                <SkeletonCartLine compact />
            </ul>

            <div data-cart-empty hidden class="py-16 text-center">
                <p class="text-muted-foreground">Your cart is empty.</p>
                <a href="/collections/all" class="btn mt-4" data-variant="secondary">Continue shopping</a>
            </div>

            <ul data-cart-lines class="list-none p-0 m-0"></ul>
        </section>
        <footer data-cart-footer hidden class="border-t border-line px-4 pb-4">
            <div class="mb-4 rounded-lg bg-paper-soft p-4">
                <div class="mb-2 flex items-center justify-between gap-3 text-sm">
                    <span class="font-medium">Free shipping progress</span>
                    <span data-cart-free-shipping-amount class="text-ink-soft">Add €100</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-line/60">
                    <div data-cart-free-shipping-progress class="h-full w-0 rounded-full bg-ink transition-[width] duration-300"></div>
                </div>
                <p data-cart-free-shipping-message class="mt-2 mb-0 text-xs text-muted-foreground">Add more to unlock free shipping.</p>
            </div>

            <div class="flex items-center justify-between mb-1">
                <span class="font-medium">Subtotal</span>
                <span data-cart-subtotal class="font-semibold">€0</span>
            </div>
            <p class="text-xs text-muted-foreground mb-4">Shipping &amp; taxes calculated at checkout.</p>
            <ul class="mb-4 flex flex-col gap-1 text-xs text-ink-soft">
                <li>Fast dispatch from our EU warehouse</li>
                <li>30-day returns on unworn items</li>
                <li>Secure checkout with encrypted payments</li>
            </ul>
            <div class="flex flex-col gap-2">
                <button data-cart-checkout class="btn w-full">Checkout</button>
                <a href="/cart" class="btn w-full" data-variant="secondary">View cart</a>
            </div>
        </footer>
    </article>
</dialog>
