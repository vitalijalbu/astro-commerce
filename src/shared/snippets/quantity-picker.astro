---
/**
 * Accessible quantity picker using WebCoreUI buttons and input.
 * Emits a bubbling `quantity-change` event whenever the value changes.
 */
import { Button, Input } from 'webcoreui/astro'

interface Props {
    id?: string
    name?: string
    label?: string
    value?: number
    min?: number
    max?: number
    className?: string
}

const {
    id = 'quantity',
    name = 'quantity',
    label = 'Quantity',
    value = 1,
    min = 1,
    max = 20,
    className
} = Astro.props

const labelId = `${id}-label`
---

<div class:list={['flex flex-col gap-1.5', className]} data-quantity-picker role="group" aria-labelledby={labelId}>
    <label id={labelId} for={id} class="text-sm font-medium">{label}</label>
    <div class="flex items-center gap-2">
        <Button
            type="button"
            theme="secondary"
            data-qty-dec
            className="!h-11 !w-11 !min-w-11 !rounded-[--radius-card] !px-0"
            aria-controls={id}
            aria-label="Decrease quantity"
        >−</Button>
        <Input
            id={id}
            name={name}
            type="number"
            min={min}
            max={max}
            step="1"
            value={value}
            data-quantity-input
            aria-label={label}
            className="!h-11 !w-18 !min-w-18 !rounded-[--radius-card] !px-0 !text-center [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
        <Button
            type="button"
            theme="secondary"
            data-qty-inc
            className="!h-11 !w-11 !min-w-11 !rounded-[--radius-card] !px-0"
            aria-controls={id}
            aria-label="Increase quantity"
        >+</Button>
    </div>
</div>

<script>
    type WindowWithQuantityPicker = Window & {
        __quantityPickerSwapBound?: boolean
    }

    const clamp = (value: number, min: number, max: number) => {
        if (Number.isNaN(value)) return min
        return Math.min(max, Math.max(min, value))
    }

    const bindPicker = (picker: HTMLElement) => {
        if (picker.dataset.bound === 'true') return
        picker.dataset.bound = 'true'

        const input = picker.querySelector<HTMLInputElement>('[data-quantity-input]')
        const dec = picker.querySelector<HTMLButtonElement>('[data-qty-dec]')
        const inc = picker.querySelector<HTMLButtonElement>('[data-qty-inc]')
        if (!input || !dec || !inc) return

        const min = Number(input.min || 1)
        const max = Number(input.max || 999)

        const syncState = () => {
            const value = clamp(Number(input.value), min, max)
            input.value = String(value)
            dec.disabled = value <= min
            inc.disabled = value >= max
            return value
        }

        const emit = () => {
            const value = syncState()
            picker.dispatchEvent(new CustomEvent('quantity-change', {
                bubbles: true,
                detail: { value }
            }))
        }

        dec.addEventListener('click', () => {
            input.value = String(clamp(Number(input.value) - 1, min, max))
            emit()
        })

        inc.addEventListener('click', () => {
            input.value = String(clamp(Number(input.value) + 1, min, max))
            emit()
        })

        input.addEventListener('input', emit)
        input.addEventListener('change', emit)
        emit()
    }

    const initQuantityPickers = () => {
        document.querySelectorAll<HTMLElement>('[data-quantity-picker]').forEach(bindPicker)
    }

    initQuantityPickers()

    const win = window as WindowWithQuantityPicker
    if (!win.__quantityPickerSwapBound) {
        win.__quantityPickerSwapBound = true
        document.addEventListener('astro:after-swap', initQuantityPickers)
    }
</script>
