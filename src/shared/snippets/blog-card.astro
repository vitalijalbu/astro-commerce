---
/**
 * Reusable article card for journal index, section previews and related posts.
 */
import { Card, Badge, Button } from 'webcoreui/astro'

interface BlogCardData {
    title: string
    excerpt: string
    image: string
    href: string
    date: string
    author?: string
    readMinutes?: number
    tags?: string[]
}

interface Props {
    post: BlogCardData
    variant?: 'default' | 'feature'
    showButton?: boolean
}

const { post, variant = 'default', showButton = true } = Astro.props
const feature = variant === 'feature'
---

<Card compact={true} flat compact className="!p-0 !border-line overflow-hidden h-full">
    <article class:list={[feature && 'grid md:grid-cols-2']} aria-label={post.title}>
        <a href={post.href} class="block group" aria-label={`Open article: ${post.title}`}>
            <div class:list={['overflow-hidden bg-paper-soft', feature ? 'aspect-[4/3] md:aspect-auto md:h-full' : 'aspect-[3/2]']}>
                <img
                    src={post.image}
                    alt={post.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
            </div>
        </a>

        <div class="p-5 md:p-6 flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
                <span>{post.date}</span>
                {post.author && <span>• {post.author}</span>}
                {post.readMinutes && <span>• {post.readMinutes} min read</span>}
            </div>

            <h2 class:list={[feature ? 'text-2xl md:text-3xl' : 'text-lg', 'font-semibold tracking-tight m-0']}>
                <a href={post.href} class="link-underline">{post.title}</a>
            </h2>
            <p class="text-ink-soft m-0 leading-relaxed">{post.excerpt}</p>

            {post.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-1" aria-label="Article tags">
                    {post.tags.slice(0, 3).map(tag => <Badge theme="outline" small>{tag}</Badge>)}
                </div>
            )}

            {showButton && (
                <div class="pt-2">
                    <Button href={post.href} theme="secondary">Read article</Button>
                </div>
            )}
        </div>
    </article>
</Card>
