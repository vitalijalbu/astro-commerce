---
interface Props {
    id: string
    title: string
    description?: string
    buttonLabel?: string
    buttonClassName?: string
}

const {
    id,
    title,
    description,
    buttonLabel = 'Filters',
    buttonClassName = ''
} = Astro.props
---

<div class="lg:hidden">
    <button type="button" class={`btn ${buttonClassName}`.trim()} data-variant="secondary" data-drawer-open={id}>
        {buttonLabel}
    </button>

    <dialog class="drawer" data-side="left" id={id}>
        <article>
            <header>
                <h3>{title}</h3>
                {description && <p class="text-sm text-muted-foreground">{description}</p>}
            </header>
            <section>
                <div class="flex flex-col gap-5">
                    <slot />

                    <button type="button" class="btn w-full" data-variant="secondary" data-drawer-close={id}>
                        Close filters
                    </button>
                </div>
            </section>
        </article>
    </dialog>
</div>
