---
import type { Product } from '@lib/types'
/**
 * Responsive product grid used by collection, search and PDP recommendations.
 */
import ProductCard from './product-card.astro'

interface Props {
    products: Product[]
    eagerCount?: number
    columns?: 2 | 3 | 4
    className?: string
}

const { products, eagerCount = 0, columns = 4, className } = Astro.props

const lgCols = {
    2: 'lg:grid-cols-2',
    3: 'lg:grid-cols-3',
    4: 'lg:grid-cols-4'
}[columns]
---

<ul role="list" class:list={['grid grid-cols-2 gap-4 md:gap-6', lgCols, className]}>
    {products.map((product, i) => (
        <li>
            <ProductCard product={product} eager={i < eagerCount} />
        </li>
    ))}
</ul>
