---
/**
 * Product card — minimal square media-first card with Dawn-like composition.
 * sale <Badge>, <Rating> stars, <Price>, and a quick-add <Button> that pushes
 * to the client cart via [data-add-to-cart].
 */
import { Badge, Rating, Button } from 'webcoreui/astro'
import Icon from './icon.astro'
import Price from './price.astro'
import { discountPercent } from '../utils/format'
import type { Product } from '../../lib/types'

interface Props {
    product: Product
    /** Eager-load the image (above-the-fold cards). */
    eager?: boolean
}

const { product, eager = false } = Astro.props
const discount = discountPercent(product.price, product.compareAtPrice)
const isNew = product.tags.includes('new')
const variant = product.variants[0]
---

<article aria-label={product.title} class="h-full">
    <div class="group flex h-full flex-col overflow-hidden rounded-[--radius-card] border border-line bg-paper">
        <a href={`/products/${product.handle}`} class="relative block" aria-label={`View ${product.title}`}>
            <div class="aspect-square overflow-hidden bg-paper-soft">
                <img
                    src={product.featuredImage.url}
                    alt={product.featuredImage.alt}
                    width={product.featuredImage.width}
                    height={product.featuredImage.height}
                    loading={eager ? 'eager' : 'lazy'}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
            </div>
            <button
                type="button"
                data-wishlist-toggle
                data-wishlist-id={product.id}
                data-wishlist-handle={product.handle}
                data-wishlist-title={product.title}
                data-wishlist-vendor={product.vendor ?? ''}
                data-wishlist-image={product.featuredImage.url}
                data-wishlist-price={product.price.amount}
                data-wishlist-currency={product.price.currencyCode}
                data-wishlist-compare-price={product.compareAtPrice?.amount ?? ''}
                data-wishlist-rating={product.rating ?? ''}
                data-wishlist-review-count={product.reviewCount ?? ''}
                data-wishlist-available={product.available ? '1' : '0'}
                aria-pressed="false"
                aria-label="Add to wishlist"
                class="absolute top-3 right-3 z-10 grid h-10 w-10 place-items-center rounded-full border border-white/60 bg-white/92 text-ink shadow-sm transition hover:bg-white data-[active=true]:bg-ink data-[active=true]:text-white"
            >
                <Icon type="heart" size={18} />
            </button>
            <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                {discount && <Badge theme="alert" small>-{discount}%</Badge>}
                {isNew && !discount && <Badge small>New</Badge>}
                {!product.available && <Badge theme="outline" small>Sold out</Badge>}
            </div>
        </a>

        <div class="flex flex-1 flex-col gap-2 p-2">
            {product.vendor && <span class="text-xs text-muted">{product.vendor}</span>}
            <h3 class="m-0 text-base">
                <a href={`/products/${product.handle}`} data-product-title class="font-medium leading-snug link-underline self-start">
                    {product.title}
                </a>
            </h3>
            {product.rating && (
                <Rating score={product.rating} size={14} reviewCount={product.reviewCount} />
            )}
            <div class="mt-auto flex items-center justify-between gap-2 pt-1">
                <Price price={product.price} compareAtPrice={product.compareAtPrice} />
                <Button
                    theme="secondary"
                    aria-label={`Add ${product.title} to cart`}
                    disabled={!product.available}
                    data-add-to-cart
                    data-id={variant.id}
                    data-handle={product.handle}
                    data-title={product.title}
                    data-variant={variant.title}
                    data-image={product.featuredImage.url}
                    data-price={product.price.amount}
                    data-currency={product.price.currencyCode}
                >
                    Add
                </Button>
            </div>
        </div>
    </div>
</article>
