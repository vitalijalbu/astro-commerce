---
import { Image } from 'astro:assets'
import type { Product } from '@lib/types'
import { discountPercent } from '@utils/format'
import Icon from './icon.astro'
import Price from './price.astro'

interface Props {
    product: Product
    eager?: boolean
}

const { product, eager = false } = Astro.props
const discount = discountPercent(product.price, product.compareAtPrice)
const isNew = product.tags.includes('new')
const variant = product.variants[0]
const featuredWidth: number = product.featuredImage.width ?? 900
const featuredHeight: number = product.featuredImage.height ?? 900
const wishlistItem = encodeURIComponent(JSON.stringify({
    id: product.id,
    handle: product.handle,
    title: product.title,
    vendor: product.vendor ?? null,
    image: product.featuredImage.url,
    price: product.price.amount,
    currency: product.price.currencyCode,
    compareAtPrice: product.compareAtPrice?.amount ?? null,
    rating: product.rating ?? null,
    reviewCount: product.reviewCount ?? null,
    available: product.available
}))
---

<article aria-label={product.title} class="h-full">
    <div class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-paper">
        <div class="relative">
            <a href={`/products/${product.handle}`} class="block" aria-label={`View ${product.title}`}>
                <div class="aspect-square overflow-hidden bg-paper-soft">
                    <Image
                        src={product.featuredImage.url}
                        alt={product.featuredImage.alt}
                        width={featuredWidth}
                        height={featuredHeight}
                        loading={eager ? 'eager' : 'lazy'}
                        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                </div>
            </a>
            <button
                type="button"
                data-wishlist-toggle
                data-wishlist-item={wishlistItem}
                aria-pressed="false"
                aria-label={`Add ${product.title} to wishlist`}
                class="absolute top-3 right-3 z-10 grid h-10 w-10 place-items-center rounded-full border border-white/60 bg-white/92 text-ink shadow-sm transition hover:bg-white data-[active=true]:bg-ink data-[active=true]:text-white"
            >
                <Icon type="heart" size={18} />
            </button>
            <div class="absolute top-3 left-3 flex flex-col gap-1.5" aria-hidden="true">
                {discount && <span class="badge" data-variant="sale">-{discount}%</span>}
                {isNew && !discount && <span class="badge">New</span>}
                {!product.available && <span class="badge">Sold out</span>}
            </div>
        </div>

        <div class="flex flex-1 flex-col gap-2 p-2">
            {product.vendor && <span class="text-xs text-muted-foreground">{product.vendor}</span>}
            <h3 class="m-0 text-base">
                <a href={`/products/${product.handle}`} data-product-title class="font-medium leading-snug link-underline self-start">
                    {product.title}
                </a>
            </h3>
            {product.rating && (
                <div class="flex items-center gap-0.5" aria-label={`${product.rating} out of 5 stars`}>
                    {[1, 2, 3, 4, 5].map(star => (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill={star <= Math.round(product.rating!) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" class={star <= Math.round(product.rating!) ? 'text-amber-400' : 'text-gray-200'}>
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                    ))}
                </div>
            )}
            <div class="mt-auto flex items-center justify-between gap-2 pt-1">
                <Price price={product.price} compareAtPrice={product.compareAtPrice} />
                <button
                    type="button"
                    class="btn"
                    data-variant="secondary"
                    aria-label={`Add ${product.title} to cart`}
                    disabled={!product.available}
                    data-add-to-cart
                    data-id={variant.id}
                    data-handle={product.handle}
                    data-title={product.title}
                    data-variant={variant.title}
                    data-image={product.featuredImage.url}
                    data-price={product.price.amount}
                    data-currency={product.price.currencyCode}
                >
                    Add
                </button>
            </div>
        </div>
    </div>
</article>
