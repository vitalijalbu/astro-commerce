---
import { Button } from '@/components/ui/button'
import { Card } from '@/components/ui/card'
import { CardContent } from '@/components/ui/card/card-content.astro'
import Icon from './icon.astro'

interface Props {
    title: string
    text: string
    icon?: string
    image?: string
    actionHref?: string
    actionLabel?: string
    secondaryHref?: string
    secondaryLabel?: string
    class?: string
}

const {
    title,
    text,
    icon = 'search',
    image,
    actionHref,
    actionLabel,
    secondaryHref,
    secondaryLabel,
    class: className
} = Astro.props
---

<Card size="sm" class={`border-border ${className ?? ''}`.trim()}>
    <CardContent>
        <section class="px-6 py-12 text-center md:px-10 md:py-16">
            <div class="mx-auto flex max-w-xl flex-col items-center gap-5">
                {image ? (
                    <img src={image} alt="" width="112" height="112" class="h-28 w-28 object-contain opacity-90" />
                ) : (
                    <span class="grid h-16 w-16 place-items-center rounded-full bg-paper-soft text-ink">
                        <Icon type={icon} size={26} />
                    </span>
                )}

                <div class="space-y-2">
                    <h1 class="m-0 text-2xl font-semibold tracking-tight md:text-3xl">{title}</h1>
                    <p class="m-0 text-ink-soft leading-relaxed">{text}</p>
                </div>

                {(actionHref || secondaryHref) && (
                    <div class="flex flex-col gap-2 pt-2 sm:flex-row">
                        {actionHref && actionLabel && <Button as="a" href={actionHref}>{actionLabel}</Button>}
                        {secondaryHref && secondaryLabel && (
                            <Button as="a" href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
                        )}
                    </div>
                )}
            </div>
        </section>
    </CardContent>
</Card>
