---
import { Image } from 'astro:assets'
import Icon from './icon.astro'

interface Props {
    title: string
    text: string
    icon?: string
    image?: string
    actionHref?: string
    actionLabel?: string
    secondaryHref?: string
    secondaryLabel?: string
    class?: string
}

const {
    title,
    text,
    icon = 'search',
    image,
    actionHref,
    actionLabel,
    secondaryHref,
    secondaryLabel,
    class: className
} = Astro.props
---

<div class={`card border-border ${className ?? ''}`.trim()}>
    <div class="card-section">
        <section class="px-6 py-12 text-center md:px-10 md:py-16">
            <div class="mx-auto flex max-w-xl flex-col items-center gap-5">
                {image ? (
                    <Image src={image} alt="" width={112} height={112} class="h-28 w-28 object-contain opacity-90" />
                ) : (
                    <span class="grid h-16 w-16 place-items-center rounded-full bg-paper-soft text-ink">
                        <Icon type={icon} size={26} />
                    </span>
                )}

                <div class="space-y-2">
                    <h1 class="m-0 text-2xl font-semibold tracking-tight md:text-3xl">{title}</h1>
                    <p class="m-0 text-ink-soft leading-relaxed">{text}</p>
                </div>

                {(actionHref || secondaryHref) && (
                    <div class="flex flex-col gap-2 pt-2 sm:flex-row">
                        {actionHref && actionLabel && <a href={actionHref} class="btn">{actionLabel}</a>}
                        {secondaryHref && secondaryLabel && (
                            <a href={secondaryHref} class="btn" data-variant="secondary">{secondaryLabel}</a>
                        )}
                    </div>
                )}
            </div>
        </section>
    </div>
</div>
