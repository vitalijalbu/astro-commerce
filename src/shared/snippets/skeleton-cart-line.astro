---
interface Props {
    compact?: boolean
}

const { compact = false } = Astro.props
---

<li class:list={['flex gap-4 border-b border-line', compact ? 'py-4' : 'py-5']}>
    <div class:list={['shrink-0 overflow-hidden rounded-lg', compact ? 'w-[72px] h-[90px]' : 'w-24 h-30']}>
        <div class="skeleton w-full h-full"></div>
    </div>
    <div class="flex-1 min-w-0 flex flex-col gap-2">
        <div class="h-4 w-3/4"><div class="skeleton h-full w-full"></div></div>
        <div class="h-3 w-1/3"><div class="skeleton h-full w-full"></div></div>
        <div class="h-8 w-24 mt-1"><div class="skeleton h-full w-full"></div></div>
    </div>
    <div class="h-4 w-12 shrink-0"><div class="skeleton h-full w-full"></div></div>
</li>
