---
import { Button } from 'webcoreui/astro'

interface Props {
    query: string
    vendors: string[]
    selectedVendors?: string[]
    onlyAvailable?: boolean
    minPrice?: number | null
    maxPrice?: number | null
}

const {
    query,
    vendors,
    selectedVendors = [],
    onlyAvailable = false,
    minPrice = null,
    maxPrice = null
} = Astro.props

const clearHref = query ? `/search?q=${encodeURIComponent(query)}` : '/search'
---

<form action="/search" method="get" class="flex flex-col gap-6">
    {query && <input type="hidden" name="q" value={query} />}

    <div class="flex items-center justify-between gap-3">
        <h2 class="m-0 text-base font-semibold">Filters</h2>
        <a href={clearHref} class="link-underline text-xs text-muted">Clear all</a>
    </div>

    <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
        <legend class="mb-1 aspect-[3/2]font-medium">Availability</legend>
        <label class="inline-flex items-center gap-2 aspect-[3/2]text-ink-soft">
            <input type="checkbox" name="available" value="1" checked={onlyAvailable} class="accent-black" />
            In stock only
        </label>
    </fieldset>

    <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
        <legend class="mb-1 aspect-[3/2]font-medium">Brand</legend>
        {vendors.length > 0 ? vendors.map(vendor => (
            <label class="inline-flex items-center gap-2 aspect-[3/2]text-ink-soft">
                <input
                    type="checkbox"
                    name="vendor"
                    value={vendor}
                    checked={selectedVendors.includes(vendor)}
                    class="accent-black"
                />
                {vendor}
            </label>
        )) : <p class="m-0 aspect-[3/2]text-muted">No vendor filters available.</p>}
    </fieldset>

    <fieldset class="m-0 border-0 p-0">
        <legend class="mb-2 aspect-[3/2]font-medium">Price range</legend>
        <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 text-xs text-muted">
                Min
                <input
                    type="number"
                    min="0"
                    step="1"
                    name="min"
                    value={minPrice ?? ''}
                    class="h-10 rounded-[--radius-card] border border-line bg-paper px-3 text-sm"
                    inputmode="numeric"
                />
            </label>
            <label class="flex flex-col gap-1 text-xs text-muted">
                Max
                <input
                    type="number"
                    min="0"
                    step="1"
                    name="max"
                    value={maxPrice ?? ''}
                    class="h-10 rounded-[--radius-card] border border-line bg-paper px-3 text-sm"
                    inputmode="numeric"
                />
            </label>
        </div>
    </fieldset>

    <Button type="submit" className="w-full">Apply filters</Button>
</form>