---
import type { HTMLAttributes } from "astro/types"

const iconMap: Record<string, string> = {
  cart: 'shopping-cart',
  close: 'x',
  refresh: 'refresh-cw',
  share: 'share-2',
}

const icons = import.meta.glob(
  "/node_modules/lucide-static/icons/*.svg",
  { eager: true }
) as Record<string, { default: (_props: HTMLAttributes<"svg">) => unknown }>

interface Props {
  type: string
  size?: number
  color?: string
  class?: string
}

const { type, size = 24, color, class: className } = Astro.props
const name = iconMap[type] ?? type
const iconPath = `/node_modules/lucide-static/icons/${name}.svg`
const module = icons[iconPath]
const Comp = module?.default
---

{Comp && (
  <Comp
    height={size}
    width={size}
    fill="none"
    style={`width:${size}px;height:${size}px`}
    class:list={['text-base', color && `text-${color}`, className]}
  />
)}
