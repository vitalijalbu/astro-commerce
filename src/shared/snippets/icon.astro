---
import { Icon as FulldevIcon } from '@/components/ui/icon'

const iconMap: Record<string, string> = {
  cart: 'shopping-cart',
  close: 'x',
  refresh: 'refresh-cw',
  share: 'share-2',
}

interface Props {
  type: string
  size?: number
  color?: string
}

const { type, size = 24, color } = Astro.props
const name = iconMap[type] ?? type
---

<FulldevIcon name={name} style={`width:${size}px;height:${size}px`} class={color ? `text-${color}` : ''} />
