---
import type { Money } from '@lib/types'
/**
 * Price display with optional strikethrough compare-at price.
 */
import { formatMoney } from '@utils/format'

interface Props {
    price: Money
    compareAtPrice?: Money | null
    className?: string
}

const { price, compareAtPrice, className } = Astro.props
const onSale = compareAtPrice && compareAtPrice.amount > price.amount
---

<span
    class:list={['inline-flex items-baseline gap-2', className]}
    data-price={price.amount}
    data-currency={price.currencyCode}
>
    <span class:list={['font-medium', onSale && 'text-sale']}>{formatMoney(price)}</span>
    {onSale && (
        <s class="text-muted aspect-[3/2]font-normal">{formatMoney(compareAtPrice!)}</s>
    )}
</span>
