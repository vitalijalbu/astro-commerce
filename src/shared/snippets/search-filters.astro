---
import { Button } from '@/components/ui/button'

interface Props {
    query: string
    vendors: string[]
    selectedVendors?: string[]
    onlyAvailable?: boolean
    minPrice?: number | null
    maxPrice?: number | null
}

const {
    query,
    vendors,
    selectedVendors = [],
    onlyAvailable = false,
    minPrice = null,
    maxPrice = null
} = Astro.props

const clearHref = query ? `/search?q=${encodeURIComponent(query)}` : '/search'
---

<aside class="rounded-lg border border-line bg-paper-soft p-5 md:p-6 h-fit" aria-label="Search filters">
    <form action="/search" method="get" class="flex flex-col gap-6">
        {query && <input type="hidden" name="q" value={query} />}

        <div class="flex items-center justify-between gap-3">
            <h2 class="text-base font-semibold m-0">Filters</h2>
            <a href={clearHref} class="text-xs text-muted-foreground link-underline">Clear all</a>
        </div>

        <fieldset class="flex flex-col gap-2 border-0 p-0 m-0">
            <legend class="text-sm font-medium mb-1">Availability</legend>
            <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
                <input type="checkbox" name="available" value="1" checked={onlyAvailable} class="accent-black" />
                In stock only
            </label>
        </fieldset>

        <fieldset class="flex flex-col gap-2 border-0 p-0 m-0">
            <legend class="text-sm font-medium mb-1">Brand</legend>
            {vendors.length > 0 ? vendors.map(vendor => (
                <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
                    <input
                        type="checkbox"
                        name="vendor"
                        value={vendor}
                        checked={selectedVendors.includes(vendor)}
                        class="accent-black"
                    />
                    {vendor}
                </label>
            )) : <p class="text-sm text-muted-foreground m-0">No vendor filters available.</p>}
        </fieldset>

        <fieldset class="border-0 p-0 m-0">
            <legend class="text-sm font-medium mb-2">Price range</legend>
            <div class="grid grid-cols-2 gap-3">
                <label class="text-xs text-muted-foreground flex flex-col gap-1">
                    Min
                    <input
                        type="number"
                        min="0"
                        step="1"
                        name="min"
                        value={minPrice ?? ''}
                        class="h-10 rounded-lg border border-line bg-paper px-3 text-sm"
                        inputmode="numeric"
                    />
                </label>
                <label class="text-xs text-muted-foreground flex flex-col gap-1">
                    Max
                    <input
                        type="number"
                        min="0"
                        step="1"
                        name="max"
                        value={maxPrice ?? ''}
                        class="h-10 rounded-lg border border-line bg-paper px-3 text-sm"
                        inputmode="numeric"
                    />
                </label>
            </div>
        </fieldset>

        <Button type="submit" class="w-full">Apply filters</Button>
    </form>
</aside>
