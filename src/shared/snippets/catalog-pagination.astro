---
interface Props {
    basePath: string
    params: URLSearchParams
    currentPage: number
    totalPages: number
    ariaLabel?: string
}

const {
    basePath,
    params,
    currentPage,
    totalPages,
    ariaLabel = 'Pagination'
} = Astro.props

const buildHref = (page: number) => {
    const next = new URLSearchParams(params)
    if (page <= 1) next.delete('page')
    else next.set('page', String(page))
    const query = next.toString()
    return query ? `${basePath}?${query}` : basePath
}

const pages = Array.from({ length: totalPages }, (_, index) => ({
    label: index + 1,
    active: index + 1 === currentPage,
    link: buildHref(index + 1)
}))

const previousLink = currentPage > 1 ? buildHref(currentPage - 1) : undefined
const nextLink = currentPage < totalPages ? buildHref(currentPage + 1) : undefined
---

{totalPages > 1 && (
    <nav aria-label={ariaLabel} class="mt-10 flex justify-center">
        <ul class="flex items-center gap-1 list-none p-0 m-0">
            {previousLink && (
                <li>
                    <a
                        href={previousLink}
                        aria-label="Previous page"
                        class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-line text-ink-soft hover:border-ink hover:text-ink transition text-sm"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                    </a>
                </li>
            )}
            {pages.map(page => (
                <li>
                    {page.active ? (
                        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-ink text-white text-sm font-medium">
                            {page.label}
                        </span>
                    ) : (
                        <a
                            href={page.link}
                            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-line text-ink-soft hover:border-ink hover:text-ink transition text-sm"
                            aria-label={`Page ${page.label}`}
                        >
                            {page.label}
                        </a>
                    )}
                </li>
            ))}
            {nextLink && (
                <li>
                    <a
                        href={nextLink}
                        aria-label="Next page"
                        class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-line text-ink-soft hover:border-ink hover:text-ink transition text-sm"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    </a>
                </li>
            )}
        </ul>
    </nav>
)}
