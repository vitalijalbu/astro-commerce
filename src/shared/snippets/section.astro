---
/**
 * Section wrapper applying the page container, vertical rhythm and background
 * treatment defined by the page-builder. Tailwind handles all spacing/layout.
 */
interface Props {
    spacing?: 'none' | 'sm' | 'md' | 'lg'
    background?: 'default' | 'muted' | 'dark'
    full?: boolean
    id?: string
    className?: string
}

const { spacing = 'md', background = 'default', full = false, id, className } = Astro.props

const pad = {
    none: '',
    sm: 'py-8 md:py-10',
    md: 'py-12 md:py-16',
    lg: 'py-16 md:py-24'
}[spacing]

const bg = {
    default: '',
    muted: 'bg-paper-soft',
    dark: 'bg-brand text-brand-contrast'
}[background]
---

<section id={id} class:list={[bg, pad, className]}>
    <div class:list={[full ? 'w-full' : 'page']}>
        <slot />
    </div>
</section>
