---
import { getProducts } from '@lib/catalog'
import ProductCarousel from '@snippets/product-carousel.astro'

interface Props {
    limit?: number
    excludeHandle?: string
    ariaLabel?: string
}

const { limit = 4, excludeHandle, ariaLabel = 'Recommended products' } = Astro.props

const recommended = (await getProducts(12))
    .filter(product => product.handle !== excludeHandle)
    .slice(0, limit)
---

{recommended.length > 0 && (
    <ProductCarousel products={recommended} ariaLabel={ariaLabel} />
)}
