---
import type { Product } from '@lib/types'
import { Carousel } from '@/components/ui/carousel'
import { CarouselContent } from '@/components/ui/carousel/carousel-content.astro'
import { CarouselItem } from '@/components/ui/carousel/carousel-item.astro'
import { CarouselPrevious } from '@/components/ui/carousel/carousel-previous.astro'
import { CarouselNext } from '@/components/ui/carousel/carousel-next.astro'
import ProductCard from './product-card.astro'

interface Props {
    products: Product[]
    ariaLabel?: string
}

const {
    products,
    ariaLabel = 'Products'
} = Astro.props
---

{products.length > 0 && (
    <div aria-label={ariaLabel}>
        <Carousel opts={{ align: 'start' }}>
            <CarouselContent>
                {products.map(product => (
                    <CarouselItem class="basis-full sm:basis-1/2 lg:basis-1/4">
                        <ProductCard product={product} />
                    </CarouselItem>
                ))}
            </CarouselContent>
            <CarouselPrevious />
            <CarouselNext />
        </Carousel>
    </div>
)}
