---
import { Button } from '@/components/ui/button'
import { Slider } from '@/components/ui/slider'

interface SubCollectionLink {
    handle: string
    title: string
}

interface Props {
    action: string
    sort: string
    clearHref: string
    subCollectionLinks: SubCollectionLink[]
    allTags: string[]
    selectedTags: string[]
    onlyAvailable: boolean
    priceFloor: number
    priceCeiling: number
    sliderMin: number
    sliderMax: number
}

const {
    action,
    sort,
    clearHref,
    subCollectionLinks,
    allTags,
    selectedTags,
    onlyAvailable,
    priceFloor,
    priceCeiling,
    sliderMin,
    sliderMax
} = Astro.props

const formatTag = (tag: string): string => tag
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
---

<form action={action} method="get" class="flex flex-col gap-6">
    <input type="hidden" name="sort" value={sort} />

    <div class="flex items-center justify-between gap-3">
        <h2 class="m-0 text-base font-semibold">Filters</h2>
        <a href={clearHref} class="link-underline text-xs text-muted-foreground">Clear all</a>
    </div>

    {subCollectionLinks.length > 0 && (
        <div class="flex flex-col gap-2">
            <h3 class="m-0 text-sm font-medium">Subcollections</h3>
            <ul class="list-none p-0 m-0 flex flex-col gap-1">
                {subCollectionLinks.slice(0, 12).map(sub => (
                    <li>
                        <a href={`/collections/${sub.handle}`} class="link-underline text-sm text-ink-soft hover:text-ink">
                            {sub.title}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    )}

    {allTags.length > 0 && (
        <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
            <legend class="mb-1 text-sm font-medium">Tags</legend>
            <div class="flex flex-col gap-2">
                {allTags.map(tag => (
                    <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
                        <input type="checkbox" name="tag" value={tag} checked={selectedTags.includes(tag)} role="checkbox" data-slot="checkbox" />
                        {formatTag(tag)}
                    </label>
                ))}
            </div>
        </fieldset>
    )}

    <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
        <legend class="mb-1 text-sm font-medium">Availability</legend>
        <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
            <input type="checkbox" name="available" value="1" checked={onlyAvailable} role="checkbox" data-slot="checkbox" />
            In stock only
        </label>
    </fieldset>

    <fieldset class="m-0 border-0 p-0">
        <legend class="mb-2 text-sm font-medium">Price range</legend>
        <div class="flex items-center justify-between text-sm text-ink-soft mb-2">
            <span>€{sliderMin}</span>
            <span>€{sliderMax}</span>
        </div>
        <Slider
            defaultValue={[sliderMin, sliderMax]}
            min={priceFloor}
            max={priceCeiling}
            step={1}
        />
        <input type="hidden" name="price" value={sliderMin} data-price-min />
        <input type="hidden" name="price" value={sliderMax} data-price-max />
    </fieldset>

    <Button type="submit" class="w-full">Apply filters</Button>
</form>
