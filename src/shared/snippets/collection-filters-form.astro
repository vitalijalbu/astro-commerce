---
import { Button, Checkbox, List, RangeSlider } from 'webcoreui/astro'

interface SubCollectionLink {
    handle: string
    title: string
}

interface Props {
    action: string
    sort: string
    clearHref: string
    subCollectionLinks: SubCollectionLink[]
    allTags: string[]
    selectedTags: string[]
    onlyAvailable: boolean
    priceFloor: number
    priceCeiling: number
    sliderMin: number
    sliderMax: number
}

const {
    action,
    sort,
    clearHref,
    subCollectionLinks,
    allTags,
    selectedTags,
    onlyAvailable,
    priceFloor,
    priceCeiling,
    sliderMin,
    sliderMax
} = Astro.props

const formatTag = (tag: string): string => tag
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
---

<form action={action} method="get" class="flex flex-col gap-6">
    <input type="hidden" name="sort" value={sort} />

    <div class="flex items-center justify-between gap-3">
        <h2 class="m-0 text-base font-semibold">Filters</h2>
        <a href={clearHref} class="link-underline text-xs text-muted">Clear all</a>
    </div>

    {subCollectionLinks.length > 0 && (
        <div class="flex flex-col gap-2">
            <h3 class="m-0 text-sm font-medium">Subcollections</h3>
            <List
                secondary
                itemGroups={[
                    {
                        items: subCollectionLinks.slice(0, 12).map(sub => ({
                            name: sub.title,
                            href: `/collections/${sub.handle}`
                        }))
                    }
                ]}
            />
        </div>
    )}

    {allTags.length > 0 && (
        <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
            <legend class="mb-1 text-sm font-medium">Tags</legend>
            <div class="flex flex-col gap-2">
                {allTags.map(tag => (
                    <Checkbox
                        name="tag"
                        value={tag}
                        checked={selectedTags.includes(tag)}
                        label={formatTag(tag)}
                    />
                ))}
            </div>
        </fieldset>
    )}

    <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
        <legend class="mb-1 text-sm font-medium">Availability</legend>
        <Checkbox
            name="available"
            value="1"
            checked={onlyAvailable}
            label="In stock only"
        />
    </fieldset>

    <fieldset class="m-0 border-0 p-0">
        <legend class="mb-2 text-sm font-medium">Price range</legend>
        <RangeSlider
            name="price"
            min={priceFloor}
            max={priceCeiling}
            selectedMin={sliderMin}
            selectedMax={sliderMax}
            minGap={1}
            updateLabels
            minLabel={`€${sliderMin}`}
            maxLabel={`€${sliderMax}`}
        />
    </fieldset>

    <Button type="submit" className="w-full">Apply filters</Button>
</form>