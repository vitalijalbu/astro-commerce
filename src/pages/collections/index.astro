---
/**
 * Collections index — grid of all categories.
 */
import Layout from '@components/layout.astro'
import CatalogPagination from '@snippets/catalog-pagination.astro'
import { Breadcrumb } from 'webcoreui/astro'
import { getCollections } from '@lib/catalog'
import { paginateItems, parsePageParam } from '@lib/paginate'

const page = parsePageParam(Astro.url.searchParams.get('page'))
const collections = await getCollections(120)
const paginated = paginateItems(collections, page, 12)
---

<Layout title="Collections — ATELIER">
    <div class="page py-8">
        <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Collections' }]} />
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mt-6 mb-8">Collections</h1>

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            {paginated.items.map(collection => (
                <a href={`/collections/${collection.handle}`} class="group block relative overflow-hidden rounded-[--radius-card] bg-paper-soft">
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src={collection.image?.url} alt={collection.title} loading="lazy"
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-5 text-white">
                        <h2 class="text-xl font-semibold m-0">{collection.title}</h2>
                        {collection.productCount && <span class="text-sm text-white/80">{collection.productCount} items</span>}
                    </div>
                </a>
            ))}
        </div>

        <CatalogPagination
            basePath="/collections"
            params={Astro.url.searchParams}
            currentPage={paginated.currentPage}
            totalPages={paginated.totalPages}
            ariaLabel="Collection pages"
        />
    </div>
</Layout>
