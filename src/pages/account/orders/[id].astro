---
import { Image } from 'astro:assets'
import AccountNav from '@components/account-nav.astro'
import Layout from '@components/layout.astro'
import { requireAuth } from '@lib/auth'
import { getOrderById, orderItemCount, orderSubtotal, orderTotal } from '@lib/orders'
import Icon from '@snippets/icon.astro'
import { formatMoney } from '@utils/format'

const guard = requireAuth(Astro)
if (guard) return guard

const { id } = Astro.params
const order = id ? getOrderById(id) : undefined

if (!order) {
    Astro.response.status = 404
}

const statusTheme: Record<string, string> = {
    Delivered: 'default', Shipped: 'secondary', Processing: 'outline', Cancelled: 'destructive'
}
const money = (amount: number) => formatMoney({ amount, currencyCode: order?.currency || 'EUR' })

const timeline = [
    { label: 'Order placed', date: order?.date, completed: true },
    { label: 'Processing', date: order?.status === 'Processing' || order?.status === 'Shipped' || order?.status === 'Delivered' ? order?.date : undefined, completed: order?.status === 'Processing' || order?.status === 'Shipped' || order?.status === 'Delivered' },
    { label: 'Shipped', date: order?.status === 'Shipped' || order?.status === 'Delivered' ? order?.date : undefined, completed: order?.status === 'Shipped' || order?.status === 'Delivered' },
    { label: 'Delivered', date: order?.status === 'Delivered' ? order?.date : undefined, completed: order?.status === 'Delivered' }
]
---

<Layout title={order ? `Order ${order.number} — ATELIER` : 'Order not found — ATELIER'}>
    <div class="page py-10 md:py-14">
        <h1 class="text-3xl font-semibold tracking-tight mb-6">Orders</h1>
        <AccountNav active="/account/orders" />

        {order ? (
            <div class="max-w-4xl">
                <a href="/account/orders" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-6 print:hidden">
                    <Icon type="chevron-left" size={16} />
                    Back to orders
                </a>

                <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
                    <div>
                        <p class="text-2xl font-semibold">{order.number}</p>
                        <p class="text-sm text-ink-soft">
                            Placed on {order.date} &middot; {orderItemCount(order)} item{orderItemCount(order) === 1 ? '' : 's'}
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="badge" data-variant={statusTheme[order.status]}>{order.status}</span>
                        <button type="button" onclick="window.print()" class="btn print:hidden" data-variant="secondary" data-size="sm" aria-label="Print order">
                            <Icon type="share" size={16} />
                            Print
                        </button>
                    </div>
                </div>

                <div class="grid md:grid-cols-[1fr_320px] gap-8">
                    <div>
                        <div class="border border-line rounded-[--radius-card] overflow-hidden mb-6">
                            <div class="bg-paper-soft px-5 py-3 border-b border-line">
                                <h2 class="m-0 text-sm font-semibold">Items</h2>
                            </div>
                            {order.lines.map(line => (
                                <div class="flex items-center gap-4 px-5 py-4 border-b border-line last:border-b-0">
                                    <Image
                                        src={`https://picsum.photos/seed/${line.imageSeed}/120/120`}
                                        alt={line.title}
                                        width={60}
                                        height={60}
                                        loading="lazy"
                                        class="w-15 h-15 rounded-[--radius-card] object-cover bg-paper-soft shrink-0"
                                    />
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium truncate">{line.title}</p>
                                        {line.variant && <p class="text-sm text-ink-soft">{line.variant}</p>}
                                        <p class="text-sm text-muted">Qty {line.quantity} &times; {money(line.price)}</p>
                                    </div>
                                    <span class="text-sm font-medium whitespace-nowrap">{money(line.price * line.quantity)}</span>
                                </div>
                            ))}
                        </div>

                        <details class="border border-line rounded-[--radius-card] print:hidden" open>
                            <summary class="px-5 py-3 text-sm font-semibold cursor-pointer hover:bg-paper-soft transition">
                                Order timeline
                            </summary>
                            <div class="px-5 py-4">
                                <div class="flex flex-col gap-4">
                                    {timeline.map((step, i) => (
                                        <div class="flex gap-3">
                                            <div class="flex flex-col items-center">
                                                <div class:list={[
                                                    'w-3 h-3 rounded-full border-2 shrink-0',
                                                    step.completed ? 'bg-ink border-ink' : 'bg-paper border-line'
                                                ]} />
                                                {i < timeline.length - 1 && (
                                                    <div class:list={[
                                                        'w-px h-8',
                                                        step.completed ? 'bg-ink' : 'bg-line'
                                                    ]} />
                                                )}
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium m-0">{step.label}</p>
                                                {step.date && <p class="text-xs text-muted m-0">{step.date}</p>}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </details>
                    </div>

                    <div>
                        <div class="border border-line rounded-[--radius-card] p-5 mb-4">
                            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted mb-3">Shipping address</h2>
                            <address class="not-italic text-sm text-ink-soft leading-relaxed">
                                <span class="text-ink font-medium block">{order.address.name}</span>
                                {order.address.line1}<br />
                                {order.address.city}, {order.address.postcode}<br />
                                {order.address.country}
                            </address>
                            {order.tracking && (
                                <p class="mt-4 pt-4 border-t border-line text-sm">
                                    <span class="text-muted">Tracking:</span>
                                    <span class="font-medium text-ink block mt-0.5">{order.tracking}</span>
                                </p>
                            )}
                        </div>

                        <div class="border border-line rounded-[--radius-card] p-5">
                            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted mb-3">Summary</h2>
                            <dl class="text-sm flex flex-col gap-2">
                                <div class="flex justify-between">
                                    <dt class="text-ink-soft">Subtotal</dt>
                                    <dd>{money(orderSubtotal(order))}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-ink-soft">Shipping</dt>
                                    <dd>{order.shipping === 0 ? 'Free' : money(order.shipping)}</dd>
                                </div>
                                <div class="flex justify-between border-t border-line pt-2 mt-1 font-semibold text-base">
                                    <dt>Total</dt>
                                    <dd>{money(orderTotal(order))}</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        ) : (
            <div class="max-w-md py-10 text-center">
                <p class="text-lg font-medium mb-2">Order not found</p>
                <p class="text-ink-soft mb-6">We couldn't find an order with that reference.</p>
                <a href="/account/orders" class="btn" data-variant="secondary">Back to orders</a>
            </div>
        )}
    </div>
</Layout>

<style is:global>
    @media print {
        .page { padding-top: 0 !important; }
        .badge { border: 1px solid currentColor !important; }
        details[open] summary { display: none; }
    }
</style>
