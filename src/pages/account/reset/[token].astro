---
import Layout from '@components/layout.astro'
import { requireGuest } from '@lib/auth'

const guard = requireGuest(Astro)
if (guard) return guard

const { token } = Astro.params

let error: string | null = null
let success = false

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const password = String(form.get('password') || '')
  const confirm = String(form.get('confirmPassword') || '')

  if (password.length < 8) {
    error = 'Password must be at least 8 characters.'
  } else if (password !== confirm) {
    error = 'Passwords do not match.'
  } else {
    try {
      const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, '')
      if (apiUrl && token) {
        await fetch(`${apiUrl}/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: token, password, passwordConfirmation: confirm }),
        })
      }
      success = true
    } catch (e) {
      error = 'Reset link is invalid or has expired. Please request a new one.'
    }
  }
}
---

<Layout title="Reset password — ATELIER">
  <div class="page py-16 md:py-24 flex justify-center">
    <div class="w-full max-w-md">
      {success ? (
        <>
          <h1 class="text-3xl font-semibold tracking-tight text-center mb-2">Password updated</h1>
          <p class="text-center text-ink-soft mb-8">
            Your password has been successfully reset.
          </p>
          <div class="alert mb-6">
            <div class="alert-title">All set</div>
            <p class="text-sm mt-1">You can now sign in with your new password.</p>
          </div>
          <a href="/login" class="btn w-full">Sign in with new password</a>
        </>
      ) : (
        <>
          <h1 class="text-3xl font-semibold tracking-tight text-center mb-2">Set new password</h1>
          <p class="text-center text-ink-soft mb-8">
            Enter your new password below.
          </p>

          {error && <div class="mb-4"><div class="alert" data-variant="destructive">{error}</div></div>}

          <form method="post" class="flex flex-col gap-4">
            <label class="flex flex-col gap-1.5 text-sm font-medium">
              New password
              <input
                type="password"
                name="password"
                placeholder="At least 8 characters"
                required
                minlength={8}
                autocomplete="new-password"
                class="input"
                aria-describedby="password-hint"
              />
              <span id="password-hint" class="text-xs text-muted-foreground">At least 8 characters.</span>
            </label>
            <label class="flex flex-col gap-1.5 text-sm font-medium">
              Confirm new password
              <input
                type="password"
                name="confirmPassword"
                placeholder="Re-enter your new password"
                required
                autocomplete="new-password"
                class="input"
              />
            </label>
            <button type="submit" class="btn w-full">Reset password</button>
          </form>

          <p class="text-center text-sm text-ink-soft mt-6">
            <a href="/login" class="link-underline font-medium">Back to sign in</a>
          </p>
        </>
      )}
    </div>
  </div>
</Layout>
