---
import AccountNav from '@components/account-nav.astro'
import AddressModal from '@components/address-modal.astro'
import Layout from '@components/layout.astro'
import { deleteAddress, getAddresses, upsertAddress } from '@lib/addresses'
import { getCurrentUser, requireAuth } from '@lib/auth'


const guard = requireAuth(Astro)
if (guard) return guard
let user = getCurrentUser(Astro)
if (!user) return Astro.redirect('/login')

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const intent = String(form.get('intent') || 'profile')
    const str = (key: string) => String(form.get(key) || '').trim()

    if (intent === 'profile') {
        const firstName = str('firstName') || user.firstName || ''
        const lastName = str('lastName') || user.lastName || ''
        user = {
            ...user,
            firstName,
            lastName,
            email: str('email') || user.email,
            name: `${firstName} ${lastName}`.trim()
        }
        // TODO: PATCH PrestaShop /api/customers/{id} here.
        Astro.cookies.set('auth_user', JSON.stringify(user), { path: '/', sameSite: 'lax' })
        return Astro.redirect('/account/profile?ok=profile')
    }

    if (intent === 'password') {
        const current = str('currentPassword')
        const next = str('newPassword')
        const confirm = str('confirmPassword')
        if (!current) return Astro.redirect('/account/profile?err=password_current#password')
        if (next.length < 8) return Astro.redirect('/account/profile?err=password_short#password')
        if (next !== confirm) return Astro.redirect('/account/profile?err=password_mismatch#password')
        // TODO: POST PrestaShop password change here.
        return Astro.redirect('/account/profile?ok=password#password')
    }

    if (intent === 'address-save') {
        const id = str('id')
        upsertAddress(Astro.cookies, {
            id: id || undefined,
            firstName: str('firstName'),
            lastName: str('lastName'),
            company: str('company') || undefined,
            line1: str('line1'),
            line2: str('line2') || undefined,
            city: str('city'),
            postcode: str('postcode'),
            country: str('country'),
            phone: str('phone') || undefined,
            isDefault: form.get('isDefault') === 'on'
        })
        return Astro.redirect(`/account/profile?ok=${id ? 'address-updated' : 'address-added'}#addresses`)
    }

    if (intent === 'address-delete') {
        deleteAddress(Astro.cookies, str('id'))
        return Astro.redirect('/account/profile?ok=address-removed#addresses')
    }
}

const addresses = getAddresses(Astro.cookies)

const params = Astro.url.searchParams
const okMessages: Record<string, string> = {
    profile: 'Your profile has been updated.',
    password: 'Your password has been changed.',
    'address-added': 'Address added.',
    'address-updated': 'Address updated.',
    'address-removed': 'Address removed.'
}
const passwordErrors: Record<string, string> = {
    password_current: 'Enter your current password.',
    password_short: 'New password must be at least 8 characters.',
    password_mismatch: 'New passwords do not match.'
}
const okMessage = okMessages[params.get('ok') ?? '']
const passwordError = passwordErrors[params.get('err') ?? '']
---

<Layout title="Profile — ATELIER">
    <div class="page py-10 md:py-14">
        <h1 class="text-3xl font-semibold tracking-tight mb-6">Profile</h1>
        <AccountNav active="/account/profile" />

        {okMessage && <div class="mb-6 max-w-lg"><div class="alert"><div class="alert-title">{okMessage}</div></div></div>}

        <section class="max-w-lg">
            <h2 class="text-xl font-semibold mb-4">Personal details</h2>
            <form method="post" class="flex flex-col gap-4">
                <input type="hidden" name="intent" value="profile" />
                <div class="grid grid-cols-2 gap-4">
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        First name
                        <input class="input" name="firstName" value={user.firstName} />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Last name
                        <input class="input" name="lastName" value={user.lastName} />
                    </label>
                </div>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Email
                    <input class="input" type="email" name="email" value={user.email} />
                </label>
                <div class="flex gap-2 mt-2">
                    <button type="submit" class="btn">Save changes</button>
                    <a href="/logout" class="btn" data-variant="secondary">Sign out</a>
                </div>
            </form>
        </section>

        <section id="password" class="max-w-lg mt-12 pt-12 border-t border-line">
            <h2 class="text-xl font-semibold mb-4">Change password</h2>
            {passwordError && <div class="mb-4"><div class="alert" data-variant="destructive"><div class="alert-title">{passwordError}</div></div></div>}
            <form method="post" class="flex flex-col gap-4">
                <input type="hidden" name="intent" value="password" />
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Current password
                    <input class="input" type="password" name="currentPassword" required {...{ autocomplete: 'current-password' }} />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    New password
                    <input class="input" type="password" name="newPassword" required {...{ autocomplete: 'new-password' }} />
                    <span class="text-xs font-normal text-ink-soft">At least 8 characters.</span>
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Confirm new password
                    <input class="input" type="password" name="confirmPassword" required {...{ autocomplete: 'new-password' }} />
                </label>
                <div class="mt-2"><button type="submit" class="btn">Update password</button></div>
            </form>
        </section>

        <section id="addresses" data-address-section class="max-w-lg mt-12 pt-12 border-t border-line">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold">Addresses</h2>
                <button type="button" class="btn" data-variant="secondary" data-size="sm" data-open-modal="addr-new">Add address</button>
            </div>

            {addresses.length === 0 ? (
                <p class="text-sm text-ink-soft">You have no saved addresses yet.</p>
            ) : (
                <div class="flex flex-col gap-3">
                    {addresses.map(a => (
                        <div class="border border-line rounded-[--radius-card] p-4 flex items-start justify-between gap-4">
                            <div class="text-sm leading-relaxed">
                                <p class="font-medium flex items-center gap-2 mb-0.5">
                                    {a.firstName} {a.lastName}
                                    {a.isDefault && <span class="badge" data-variant="secondary">Default</span>}
                                </p>
                                {a.company && <p class="text-ink-soft">{a.company}</p>}
                                <p class="text-ink-soft">{a.line1}{a.line2 ? `, ${a.line2}` : ''}</p>
                                <p class="text-ink-soft">{a.city}, {a.postcode}</p>
                                <p class="text-ink-soft">{a.country}</p>
                                {a.phone && <p class="text-ink-soft">{a.phone}</p>}
                            </div>
                            <div class="flex flex-col gap-2 shrink-0">
                                <button type="button" class="btn" data-variant="secondary" data-size="sm" data-open-modal={`addr-edit-${a.id}`}>Edit</button>
                                <button
                                    type="button"
                                    class="btn w-full text-sale"
                                    data-variant="ghost"
                                    data-size="sm"
                                    data-delete-id={a.id}
                                    data-delete-label={`${a.firstName} ${a.lastName}`}
                                >Delete</button>
                            </div>
                        </div>
                    ))}
                </div>
            )}

            <AddressModal id="addr-new" title="Add address" />
            {addresses.map(a => (
                <AddressModal id={`addr-edit-${a.id}`} title="Edit address" address={a} />
            ))}

            <dialog class="dialog" id="addr-delete-confirm" aria-labelledby="addr-delete-title">
                <article>
                    <header>
                        <h3 id="addr-delete-title">Remove address</h3>
                    </header>
                    <section>
                        <p class="text-sm text-ink-soft mt-1">
                            Remove <span data-delete-label class="font-medium text-ink">this address</span> from your account? This can't be undone.
                        </p>
                        <form method="post" class="flex gap-2 mt-5">
                            <input type="hidden" name="intent" value="address-delete" />
                            <input type="hidden" name="id" data-delete-id-input />
                            <button type="submit" class="btn" data-variant="destructive">Remove address</button>
                            <button type="button" class="btn" data-variant="secondary" onclick="this.closest('dialog').close()">Cancel</button>
                        </form>
                    </section>
                    <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close dialog" onclick="this.closest('dialog').close()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </article>
            </dialog>
        </section>
    </div>
</Layout>

<script>
    const initAccountModals = () => {
        const section = document.querySelector<HTMLElement>('[data-address-section]')
        if (!section || section.dataset.bound === 'true') return
        section.dataset.bound = 'true'

        section.querySelectorAll<HTMLElement>('[data-open-modal]').forEach(trigger => {
            trigger.addEventListener('click', () => {
                const id = trigger.dataset.openModal
                if (!id) return
                const el = document.getElementById(id)
                if (el instanceof HTMLDialogElement) el.showModal()
            })
        })

        const deleteIdInput = section.querySelector<HTMLInputElement>('[data-delete-id-input]')
        const deleteLabel = section.querySelector<HTMLElement>('[data-delete-label]')
        section.querySelectorAll<HTMLElement>('[data-delete-id]').forEach(trigger => {
            trigger.addEventListener('click', () => {
                if (deleteIdInput) deleteIdInput.value = trigger.dataset.deleteId || ''
                if (deleteLabel) deleteLabel.textContent = trigger.dataset.deleteLabel || 'this address'
                const dialog = document.getElementById('addr-delete-confirm')
                if (dialog instanceof HTMLDialogElement) dialog.showModal()
            })
        })
    }

    initAccountModals()
    document.addEventListener('astro:after-swap', initAccountModals)
</script>
