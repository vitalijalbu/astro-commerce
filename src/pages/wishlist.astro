---
import Layout from '@components/layout.astro'
import EmptyState from '@snippets/empty-state.astro'
import SkeletonProductCard from '@snippets/skeleton-product-card.astro'

---

<Layout title="Wishlist — ATELIER" noindex>
    <div class="page py-10 md:py-14" data-wishlist-page>
        <div class="mb-8 flex flex-col gap-2">
            <h1 class="m-0 text-3xl font-semibold tracking-tight md:text-4xl">Wishlist</h1>
            <p class="m-0 max-w-2xl text-ink-soft">Saved pieces live locally in your browser so you can come back to them later.</p>
        </div>

        <div data-wishlist-loading class="grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-4">
            <SkeletonProductCard />
            <SkeletonProductCard />
            <SkeletonProductCard />
            <SkeletonProductCard />
        </div>

        <div data-wishlist-empty hidden>
            <EmptyState
                title="Your wishlist is empty"
                text="Save products with the heart icon and they will appear here for quick comparison later."
                image="/images/placeholder.png"
                actionHref="/collections/all"
                actionLabel="Browse all products"
                secondaryHref="/"
                secondaryLabel="Back home"
            />
        </div>

        <section data-wishlist-body hidden>
            <div data-wishlist-grid class="grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-4"></div>
        </section>

        <div hidden aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
    </div>
</Layout>