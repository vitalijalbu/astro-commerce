---
import { Image } from 'astro:assets'
/**
 * Product detail page (PDP), rendered on demand (SSR).
 *
 * Uses fulldev/ui throughout: <Breadcrumb>, <Rating>, <Badge>, <Carousel>,
 * <Button>, <Accordion>. Quantity uses a native number input for accessibility.
 */
import Layout from '@components/layout.astro'
import { getProductByHandle } from '@lib/catalog'
import EmptyState from '@snippets/empty-state.astro'
import Icon from '@snippets/icon.astro'
import JsonLd from '@snippets/json-ld.astro'
import Price from '@snippets/price.astro'
import ProductRecommendations from '@snippets/product-recommendations.astro'
import QuantityPicker from '@snippets/quantity-picker.astro'
import SkeletonProductGrid from '@snippets/skeleton-product-grid.astro'
import { discountPercent } from '@utils/format'
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/ui/accordion'
import { Badge } from '@/components/ui/badge'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb'
import { Button } from '@/components/ui/button'
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel'
import { Rating } from '@/components/ui/rating'

const { handle } = Astro.params
const product = handle ? await getProductByHandle(handle) : null

if (!product) {
    Astro.response.status = 404
}

const productVariantId = product?.variants[0]?.id ?? ''
const productVariantTitle = product?.variants[0]?.title ?? 'Default'
const discount = product ? discountPercent(product.price, product.compareAtPrice) : null
const galleryImages = product ? (product.images.length > 0 ? product.images : [product.featuredImage]) : []
const productUrl = product ? new URL(`/products/${product.handle}`, Astro.url).toString() : ''
const productSchema = product ? {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    description: product.description,
    image: galleryImages.map(image => image.url),
    sku: productVariantId || undefined,
    brand: product.vendor ? {
        '@type': 'Brand',
        name: product.vendor
    } : undefined,
    offers: {
        '@type': 'Offer',
        url: productUrl,
        priceCurrency: product.price.currencyCode,
        price: product.price.amount,
        availability: product.available
            ? 'https://schema.org/InStock'
            : 'https://schema.org/OutOfStock',
        itemCondition: 'https://schema.org/NewCondition'
    },
    aggregateRating: product.rating ? {
        '@type': 'AggregateRating',
        ratingValue: product.rating,
        reviewCount: product.reviewCount || 1
    } : undefined
} : null

const accordionItems = product ? [
    { title: 'Description', content: product.descriptionHtml, expanded: true },
    { title: 'Shipping & returns', content: 'Free standard shipping on orders over €100. Easy 30-day returns — items must be unworn with tags attached.' },
    { title: 'Materials & care', content: 'Made from premium natural materials. Follow the care label; cool wash and lay flat to dry where possible.' }
] : []

// Build selectable option groups (e.g. Size, Colour) from the variants.
// With single-variant products this is empty and the selector is hidden —
// it lights up automatically once PrestaShop returns real variant options.
const optionGroups = product
    ? [...product.variants.reduce((groups, variant) => {
        for (const option of variant.options ?? []) {
            const values = groups.get(option.name) ?? new Set<string>()
            values.add(option.value)
            groups.set(option.name, values)
        }
        return groups
    }, new Map<string, Set<string>>())].map(([name, values]) => ({ name, values: [...values] }))
    : []

// Estimated delivery window (2–4 working days), formatted server-side.
const fmtDay = (date: Date): string =>
    date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })
const deliveryEstimate = `${fmtDay(new Date(Date.now() + 2 * 86_400_000))} – ${fmtDay(new Date(Date.now() + 4 * 86_400_000))}`

const pdpWishlistItem = product
    ? encodeURIComponent(JSON.stringify({
        id: product.id,
        handle: product.handle,
        title: product.title,
        vendor: product.vendor ?? null,
        image: product.featuredImage.url,
        price: product.price.amount,
        currency: product.price.currencyCode,
        compareAtPrice: product.compareAtPrice?.amount ?? null,
        rating: product.rating ?? null,
        reviewCount: product.reviewCount ?? null,
        available: product.available
    }))
    : ''
---

<Layout
    title={product ? `${product.title} — ATELIER` : 'Product not found — ATELIER'}
    description={product?.description ?? 'This product could not be found.'}
    image={product?.featuredImage.url}
    type="product"
>
    <div class="page py-6 md:py-10">
        {product ? (
            <>
                <Breadcrumb>
            <BreadcrumbList>
                <BreadcrumbItem><BreadcrumbLink href="/">Home</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem><BreadcrumbLink href="/collections/all">Shop</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem><BreadcrumbPage>{product.title}</BreadcrumbPage></BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-14 mt-6">
            <!-- Gallery -->
            <div>
                <div class="product-gallery overflow-hidden rounded-[--radius-card] border border-line bg-paper-soft" aria-label="Product gallery">
                    <Carousel class="w-full">
                        <CarouselContent>
                            {galleryImages.map((image, i) => (
                                <CarouselItem class="basis-full">
                                    <Image
                                        src={image.url}
                                        alt={image.alt || `${product.title} image ${i + 1}`}
                                        width={image.width ?? 1000}
                                        height={image.height ?? 1250}
                                        loading={i === 0 ? 'eager' : 'lazy'}
                                        fetchpriority={i === 0 ? 'high' : 'auto'}
                                        sizes="(min-width: 768px) 50vw, 100vw"
                                        class="w-full object-cover aspect-4/5"
                                    />
                                </CarouselItem>
                            ))}
                        </CarouselContent>
                        {galleryImages.length > 1 && (
                            <>
                                <CarouselPrevious class="left-3" />
                                <CarouselNext class="right-3" />
                            </>
                        )}
                    </Carousel>
                </div>

                <ul role="list" class="mt-3 grid grid-cols-5 gap-2">
                    {galleryImages.slice(0, 5).map((image, i) => (
                        <li class="overflow-hidden rounded-[--radius-card] border border-line bg-paper-soft">
                            <Image
                                src={image.url}
                                alt={image.alt || `${product.title} thumbnail ${i + 1}`}
                                width={image.width ?? 200}
                                height={image.height ?? 250}
                                loading="lazy"
                                sizes="20vw"
                                class="aspect-4/5 w-full object-cover"
                            />
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Info -->
            <div class="flex flex-col">
                {product.vendor && <span class="eyebrow mb-2">{product.vendor}</span>}
                <h1 class="text-3xl md:text-4xl font-semibold tracking-tight m-0">{product.title}</h1>

                <div class="flex items-center gap-3 mt-8" data-pdp-buy-block>
                    {product.rating && (
                        <div class="flex items-center gap-2">
                            <Rating value={product.rating} />
                            <span class="text-sm text-ink-soft">
                                {product.rating.toFixed(1)}{product.reviewCount ? ` (${product.reviewCount})` : ''}
                            </span>
                        </div>
                    )}
                </div>

                <div class="flex items-center gap-3 mt-4">
                    <Price price={product.price} compareAtPrice={product.compareAtPrice} className="text-2xl" />
                <div
                    data-pdp-sticky-bar
                    hidden
                    class="fixed inset-x-0 top-16 md:top-20 z-30 border-b border-line bg-paper/95 shadow-sm backdrop-blur"
                >
                    <div class="page flex items-center gap-3 py-3">
                        <Image
                            src={product.featuredImage.url}
                            alt={product.title}
                            width={52}
                            height={52}
                            sizes="52px"
                            class="h-13 w-13 rounded-[--radius-card] object-cover bg-paper-soft"
                        />
                        <div class="min-w-0 flex-1">
                            <p class="m-0 truncate text-sm font-medium">{product.title}</p>
                            <p class="m-0 text-sm text-ink-soft">{product.price.currencyCode} {product.price.amount}</p>
                        </div>
                        <Button
                            variant="secondary"
                            data-add-to-cart
                            data-id={productVariantId}
                            data-handle={product.handle}
                            data-title={product.title}
                            data-variant={productVariantTitle}
                            data-image={product.featuredImage.url}
                            data-price={product.price.amount}
                            data-currency={product.price.currencyCode}
                            data-quantity="1"
                            aria-label={`Add ${product.title} to cart`}
                            disabled={!product.available}
                            class="shrink-0"
                        >
                            {product.available ? 'Add to cart' : 'Sold out'}
                        </Button>
                    </div>
                </div>

                    {discount && <Badge variant="destructive">-{discount}%</Badge>}
                    {!product.available && <Badge variant="outline">Sold out</Badge>}
                </div>

                <p class="text-ink-soft mt-4 leading-relaxed">{product.description}</p>

                <!-- Variant options (size / colour …) — render only when present -->
                {optionGroups.map(group => (
                    <fieldset class="mt-6 m-0 border-0 p-0">
                        <legend class="mb-2 flex w-full items-center justify-between gap-2 text-sm font-medium">
                            <span>{group.name}</span>
                            {group.name.toLowerCase() === 'size' && (
                                <a href="/pages/size-guide" class="text-xs text-muted link-underline">Size guide</a>
                            )}
                        </legend>
                        <div class="flex flex-wrap gap-2" role="radiogroup" aria-label={group.name}>
                            {group.values.map((value, i) => (
                                <button
                                    type="button"
                                    data-variant-option={group.name}
                                    data-variant-value={value}
                                    role="radio"
                                    aria-checked={i === 0 ? 'true' : 'false'}
                                    class="min-w-11 rounded-[--radius-card] border border-line px-4 py-2 text-sm transition hover:border-ink aria-checked:border-ink aria-checked:bg-ink aria-checked:text-white"
                                >
                                    {value}
                                </button>
                            ))}
                        </div>
                    </fieldset>
                ))}

                <!-- Quantity + add to cart + wishlist -->
                <div class="flex items-center gap-3 mt-8">
                    <QuantityPicker id="pdp-quantity" name="quantity" value={1} min={1} max={12} />
                    <Button
                        class="flex-1"
                        disabled={!product.available}
                        data-add-to-cart
                        data-id={productVariantId}
                        data-handle={product.handle}
                        data-title={product.title}
                        data-variant={productVariantTitle}
                        data-image={product.featuredImage.url}
                        data-price={product.price.amount}
                        data-currency={product.price.currencyCode}
                        data-quantity="1"
                        aria-label={`Add ${product.title} to cart`}
                    >
                        {product.available ? 'Add to cart' : 'Sold out'}
                    </Button>
                    <Button
                        type="button"
                        variant="outline"
                        size="icon"
                        data-wishlist-toggle
                        data-wishlist-item={pdpWishlistItem}
                        aria-pressed="false"
                        aria-label={`Add ${product.title} to wishlist`}
                    >
                        <Icon type="heart" size={18} />
                    </Button>
                </div>

                <!-- Delivery estimate + share -->
                <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
                    <p class="m-0 flex items-center gap-2 text-ink-soft">
                        <Icon type="truck" size={16} />
                        <span>Estimated delivery <strong class="font-medium text-ink">{deliveryEstimate}</strong></span>
                    </p>
                    <button type="button" data-pdp-share class="inline-flex items-center gap-1.5 text-muted link-underline">
                        <Icon type="share" size={15} /> Share
                    </button>
                </div>

                <!-- Trust badges -->
                <ul role="list" class="grid grid-cols-3 gap-3 mt-6 text-center text-xs text-ink-soft">
                    <li class="flex flex-col items-center gap-1.5"><Icon type="truck" size={20} /><span>Free shipping €100+</span></li>
                    <li class="flex flex-col items-center gap-1.5"><Icon type="refresh" size={20} /><span>30-day returns</span></li>
                    <li class="flex flex-col items-center gap-1.5"><Icon type="shield" size={20} /><span>Secure checkout</span></li>
                </ul>

                <div class="mt-8 border-t border-line pt-2">
                    <Accordion
                        collapsible
                        defaultValue={accordionItems.find(item => item.expanded)?.title}
                    >
                        {accordionItems.map(item => (
                            <AccordionItem value={item.title}>
                                <AccordionTrigger>{item.title}</AccordionTrigger>
                                <AccordionContent>
                                    <div class="prose-sm" set:html={item.content} />
                                </AccordionContent>
                            </AccordionItem>
                        ))}
                    </Accordion>
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        {recommended.length > 0 && (
            <section class="mt-16 md:mt-24">
                <h2 class="text-2xl font-semibold tracking-tight mb-8">You may also like</h2>
                <ProductCarousel products={recommended} ariaLabel="Recommended products" />
            </section>
        )}

                {productSchema && <JsonLd slot="structured-data" data={productSchema} />}
            </>
        ) : (
            <EmptyState
                title="Product not found"
                text="This product is no longer available or may have moved. Explore the full catalog or return to the homepage."
                image="/images/placeholder.png"
                actionHref="/collections/all"
                actionLabel="Browse all products"
                secondaryHref="/"
                secondaryLabel="Back home"
            />
        )}
    </div>
</Layout>

<script>
    const syncPdpQuantity = () => {
        const input = document.querySelector<HTMLInputElement>('#pdp-quantity')
        const buttons = document.querySelectorAll<HTMLElement>('[data-add-to-cart]')
        if (!input || buttons.length === 0) return
        if (input.dataset.bound === 'true') return
        input.dataset.bound = 'true'

        const update = () => {
            const qty = Math.max(1, Number(input.value) || 1)
            input.value = String(qty)
            buttons.forEach(button => {
                button.dataset.quantity = String(qty)
            })
        }

        update()
        input.addEventListener('input', update)
        input.addEventListener('change', update)
        document.addEventListener('quantity-change', update)
    }

    syncPdpQuantity()
    document.addEventListener('astro:after-swap', syncPdpQuantity)

    const initStickyBar = () => {
        const observed = document.querySelector<HTMLElement>('[data-pdp-buy-block]')
        const bar = document.querySelector<HTMLElement>('[data-pdp-sticky-bar]')
        if (!observed || !bar) return
        if (bar.dataset.bound === 'true') return
        bar.dataset.bound = 'true'

        const updateVisibility = (visible: boolean) => {
            bar.toggleAttribute('hidden', !visible)
        }

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(([entry]) => {
                // Only show the bar once the buy block has scrolled ABOVE the
                // viewport (scrolled down past it). When it sits below the
                // viewport — e.g. at the top of the page — keep the bar hidden
                // so it never overlays the header.
                const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0
                updateVisibility(scrolledPast)
            }, { threshold: 0 })

            observer.observe(observed)
        }
    }

    initStickyBar()
    document.addEventListener('astro:after-swap', initStickyBar)

    // Variant pills: single-select per group; reflect choice on the cart buttons.
    const initVariantSelector = () => {
        document.querySelectorAll<HTMLElement>('[role="radiogroup"]').forEach(group => {
            if (group.dataset.bound === 'true') return
            group.dataset.bound = 'true'
            group.addEventListener('click', e => {
                const pill = (e.target as HTMLElement).closest<HTMLElement>('[data-variant-value]')
                if (!pill) return
                group.querySelectorAll('[data-variant-value]').forEach(b => b.setAttribute('aria-checked', 'false'))
                pill.setAttribute('aria-checked', 'true')

                const selected = [...document.querySelectorAll<HTMLElement>('[aria-checked="true"][data-variant-value]')]
                    .map(b => b.dataset.variantValue)
                    .join(' / ')
                document.querySelectorAll<HTMLElement>('[data-add-to-cart]').forEach(btn => {
                    if (selected) btn.dataset.variant = selected
                })
            })
        })
    }
    initVariantSelector()
    document.addEventListener('astro:after-swap', initVariantSelector)

    // Share: native share sheet when available, clipboard copy as a fallback.
    const initShare = () => {
        const button = document.querySelector<HTMLButtonElement>('[data-pdp-share]')
        if (!button || button.dataset.bound === 'true') return
        button.dataset.bound = 'true'
        button.addEventListener('click', async () => {
            const data = { title: document.title, url: location.href }
            try {
                if (navigator.share) await navigator.share(data)
                else {
                    await navigator.clipboard.writeText(location.href)
                    const original = button.textContent
                    button.textContent = 'Link copied'
                    setTimeout(() => { button.textContent = original }, 1800)
                }
            } catch { /* user dismissed the share sheet */ }
        })
    }
    initShare()
    document.addEventListener('astro:after-swap', initShare)
</script>
