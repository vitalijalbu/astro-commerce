---
/**
 * Product detail page (PDP), rendered on demand (SSR).
 *
 * Uses WebCoreUI throughout: <Breadcrumb>, <Rating>, <Badge>, <Carousel>,
 * <Button>, <Accordion>. Quantity uses a native number input for accessibility.
 */
import Layout from '@components/layout.astro'
import EmptyState from '@snippets/empty-state.astro'
import ProductGrid from '@snippets/product-grid.astro'
import Price from '@snippets/price.astro'
import Icon from '@snippets/icon.astro'
import JsonLd from '@snippets/json-ld.astro'
import QuantityPicker from '@snippets/quantity-picker.astro'
import { Breadcrumb, Rating, Badge, Carousel, CarouselItem, Button, Accordion } from 'webcoreui/astro'
import { getProductByHandle, getProducts } from '../../lib/catalog'
import { discountPercent } from '@utils/format'

const { handle } = Astro.params
const product = await getProductByHandle(handle!)

if (!product) {
    Astro.response.status = 404
}

const productVariantId = product?.variants[0]?.id ?? ''
const productVariantTitle = product?.variants[0]?.title ?? 'Default'
const discount = product ? discountPercent(product.price, product.compareAtPrice) : null
const recommended = product ? (await getProducts(12)).filter(p => p.handle !== product.handle).slice(0, 4) : []
const galleryImages = product ? (product.images.length > 0 ? product.images : [product.featuredImage]) : []
const productUrl = product ? new URL(`/products/${product.handle}`, Astro.url).toString() : ''
const productSchema = product ? {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    description: product.description,
    image: galleryImages.map(image => image.url),
    sku: productVariantId || undefined,
    brand: product.vendor ? {
        '@type': 'Brand',
        name: product.vendor
    } : undefined,
    offers: {
        '@type': 'Offer',
        url: productUrl,
        priceCurrency: product.price.currencyCode,
        price: product.price.amount,
        availability: product.available
            ? 'https://schema.org/InStock'
            : 'https://schema.org/OutOfStock',
        itemCondition: 'https://schema.org/NewCondition'
    },
    aggregateRating: product.rating ? {
        '@type': 'AggregateRating',
        ratingValue: product.rating,
        reviewCount: product.reviewCount || 1
    } : undefined
} : null

const accordionItems = product ? [
    { title: 'Description', content: product.descriptionHtml, expanded: true },
    { title: 'Shipping & returns', content: 'Free standard shipping on orders over €100. Easy 30-day returns — items must be unworn with tags attached.' },
    { title: 'Materials & care', content: 'Made from premium natural materials. Follow the care label; cool wash and lay flat to dry where possible.' }
] : []
---

<Layout
    title={product ? `${product.title} — ATELIER` : 'Product not found — ATELIER'}
    description={product?.description ?? 'This product could not be found.'}
    image={product?.featuredImage.url}
    type="product"
>
    <div class="page py-6 md:py-10">
        {product ? (
            <>
                <Breadcrumb items={[
            { href: '/', label: 'Home' },
            { href: '/collections/all', label: 'Shop' },
            { label: product.title }
        ]} />

        <div class="grid md:grid-cols-2 gap-8 lg:gap-14 mt-6">
            <!-- Gallery -->
            <div>
                <div class="overflow-hidden rounded-[--radius-card] border border-line bg-paper-soft" aria-label="Product gallery">
                    <Carousel
                        items={galleryImages.length}
                        itemsPerSlide={1}
                        pagination={{ type: 'dots' }}
                        className="w-full"
                    >
                        {galleryImages.map((image, i) => (
                            <CarouselItem>
                                <img
                                    src={image.url}
                                    alt={image.alt || `${product.title} image ${i + 1}`}
                                    width={image.width}
                                    height={image.height}
                                    loading={i === 0 ? 'eager' : 'lazy'}
                                    class="w-full object-cover aspect-4/5"
                                />
                            </CarouselItem>
                        ))}
                    </Carousel>
                </div>

                <ul role="list" class="mt-3 grid grid-cols-5 gap-2">
                    {galleryImages.slice(0, 5).map((image, i) => (
                        <li class="overflow-hidden rounded-[--radius-card] border border-line bg-paper-soft">
                            <img
                                src={image.url}
                                alt={image.alt || `${product.title} thumbnail ${i + 1}`}
                                loading="lazy"
                                class="aspect-4/5 w-full object-cover"
                            />
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Info -->
            <div class="flex flex-col">
                {product.vendor && <span class="eyebrow mb-2">{product.vendor}</span>}
                <h1 class="text-3xl md:text-4xl font-semibold tracking-tight m-0">{product.title}</h1>

                <div class="flex items-center gap-3 mt-8" data-pdp-buy-block>
                    {product.rating && (
                        <Rating score={product.rating} size={16} reviewCount={product.reviewCount} showText />
                    )}
                </div>

                <div class="flex items-center gap-3 mt-4">
                    <Price price={product.price} compareAtPrice={product.compareAtPrice} className="text-2xl" />
                <div
                    data-pdp-sticky-bar
                    hidden
                    class="fixed inset-x-0 top-0 z-60 border-b border-line bg-paper/95 shadow-sm backdrop-blur"
                >
                    <div class="page flex items-center gap-3 py-3">
                        <img
                            src={product.featuredImage.url}
                            alt={product.title}
                            width={52}
                            height={52}
                            class="h-13 w-13 rounded-[--radius-card] object-cover bg-paper-soft"
                        />
                        <div class="min-w-0 flex-1">
                            <p class="m-0 truncate text-sm font-medium">{product.title}</p>
                            <p class="m-0 text-sm text-ink-soft">{product.price.currencyCode} {product.price.amount}</p>
                        </div>
                        <Button
                            theme="secondary"
                            data-add-to-cart
                            data-id={productVariantId}
                            data-handle={product.handle}
                            data-title={product.title}
                            data-variant={productVariantTitle}
                            data-image={product.featuredImage.url}
                            data-price={product.price.amount}
                            data-currency={product.price.currencyCode}
                            data-quantity="1"
                            aria-label={`Add ${product.title} to cart`}
                            disabled={!product.available}
                            className="shrink-0"
                        >
                            {product.available ? 'Add to cart' : 'Sold out'}
                        </Button>
                    </div>
                </div>

                    {discount && <Badge theme="alert" small>-{discount}%</Badge>}
                    {!product.available && <Badge theme="outline" small>Sold out</Badge>}
                </div>

                <p class="text-ink-soft mt-4 leading-relaxed">{product.description}</p>

                <!-- Quantity + add to cart -->
                <div class="flex items-center gap-3 mt-8">
                   
                        <QuantityPicker id="pdp-quantity" name="quantity" value={1} min={1} max={12} />
                    
                    <Button
                        className="flex-1"
                        disabled={!product.available}
                        data-add-to-cart
                        data-id={productVariantId}
                        data-handle={product.handle}
                        data-title={product.title}
                        data-variant={productVariantTitle}
                        data-image={product.featuredImage.url}
                        data-price={product.price.amount}
                        data-currency={product.price.currencyCode}
                        data-quantity="1"
                        aria-label={`Add ${product.title} to cart`}
                    >
                        {product.available ? 'Add to cart' : 'Sold out'}
                    </Button>
                </div>

                <!-- Trust badges -->
                <ul role="list" class="grid grid-cols-3 gap-3 mt-6 text-center text-xs text-ink-soft">
                    <li class="flex flex-col items-center gap-1.5"><Icon type="truck" size={20} /><span>Free shipping €100+</span></li>
                    <li class="flex flex-col items-center gap-1.5"><Icon type="refresh" size={20} /><span>30-day returns</span></li>
                    <li class="flex flex-col items-center gap-1.5"><Icon type="shield" size={20} /><span>Secure checkout</span></li>
                </ul>

                <div class="mt-8 border-t border-line pt-2">
                    <Accordion items={accordionItems} icon="plus" />
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        {recommended.length > 0 && (
            <section class="mt-16 md:mt-24">
                <h2 class="text-2xl font-semibold tracking-tight mb-8">You may also like</h2>
                <ProductGrid products={recommended} />
            </section>
        )}

                {productSchema && <JsonLd slot="structured-data" data={productSchema} />}
            </>
        ) : (
            <EmptyState
                title="Product not found"
                text="This product is no longer available or may have moved. Explore the full catalog or return to the homepage."
                image="/images/placeholder.png"
                actionHref="/collections/all"
                actionLabel="Browse all products"
                secondaryHref="/"
                secondaryLabel="Back home"
            />
        )}
    </div>
</Layout>

<script>
    const syncPdpQuantity = () => {
        const input = document.querySelector<HTMLInputElement>('#pdp-quantity')
        const buttons = document.querySelectorAll<HTMLElement>('[data-add-to-cart]')
        if (!input || buttons.length === 0) return
        if (input.dataset.bound === 'true') return
        input.dataset.bound = 'true'

        const update = () => {
            const qty = Math.max(1, Number(input.value) || 1)
            input.value = String(qty)
            buttons.forEach(button => {
                button.dataset.quantity = String(qty)
            })
        }

        update()
        input.addEventListener('input', update)
        input.addEventListener('change', update)
        document.addEventListener('quantity-change', update)
    }

    syncPdpQuantity()
    document.addEventListener('astro:after-swap', syncPdpQuantity)

    const initStickyBar = () => {
        const observed = document.querySelector<HTMLElement>('[data-pdp-buy-block]')
        const bar = document.querySelector<HTMLElement>('[data-pdp-sticky-bar]')
        if (!observed || !bar) return
        if (bar.dataset.bound === 'true') return
        bar.dataset.bound = 'true'

        const updateVisibility = (visible: boolean) => {
            bar.toggleAttribute('hidden', !visible)
        }

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(([entry]) => {
                updateVisibility(!entry.isIntersecting)
            }, { threshold: 0.15 })

            observer.observe(observed)
        }
    }

    initStickyBar()
    document.addEventListener('astro:after-swap', initStickyBar)
</script>
