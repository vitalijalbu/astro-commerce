---
import { Image } from 'astro:assets'
import Layout from '@components/layout.astro'
import { formatBlogDate, getBlogPostBySlug, getRelatedBlogSummaries } from '@lib/blog'
import BlogCard from '@snippets/blog-card.astro'
import EmptyState from '@snippets/empty-state.astro'
import JsonLd from '@snippets/json-ld.astro'


const { slug } = Astro.params
const post = getBlogPostBySlug(slug || '')

if (!post) {
    Astro.response.status = 404
}

const related = post ? getRelatedBlogSummaries(post.slug, 3) : []
const date = post ? formatBlogDate(post.publishedAt) : ''

const articleSchema = post ? {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.excerpt,
    image: [post.image],
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    author: {
        '@type': 'Person',
        name: post.author.name
    },
    publisher: {
        '@type': 'Organization',
        name: 'ATELIER'
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': new URL(`/blog/${post.slug}`, Astro.url).toString()
    }
} : null
---

<Layout
    title={post ? `${post.title} — Journal — ATELIER` : 'Article not found — ATELIER'}
    description={post?.excerpt ?? 'This journal article could not be found.'}
    image={post?.image}
    type="article"
>
    <div class="page py-8 md:py-12">
        {post ? (
            <>
                <nav class="breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li>→</li>
                        <li><a href="/blog">Journal</a></li>
                        <li>→</li>
                        <li aria-current="page">{post.title}</li>
                    </ol>
                </nav>

                <article class="max-w-3xl mx-auto mt-6" aria-labelledby="article-title">
                    <header class="flex flex-col gap-4 mb-6">
                        <div class="flex flex-wrap items-center gap-2" aria-label="Article tags">
                            {post.tags.map(tag => <span class="badge" data-variant="outline">{tag}</span>)}
                        </div>

                        <h1 id="article-title" class="text-4xl md:text-5xl font-semibold tracking-tight m-0">{post.title}</h1>

                        <div class="text-sm text-muted-foreground flex flex-wrap items-center gap-2">
                            <span>{date}</span>
                            <span>•</span>
                            <span>{post.author.name}</span>
                            <span>•</span>
                            <span>{post.readMinutes} min read</span>
                        </div>

                        <p class="text-lg text-ink-soft m-0 leading-relaxed">{post.excerpt}</p>
                    </header>

                    <figure class="overflow-hidden rounded-lg border border-line bg-paper-soft mb-8">
                        <Image src={post.image} alt={post.title} width={1200} height={780} class="w-full aspect-[16/9] object-cover" loading="eager" />
                    </figure>

                    <div class="flex flex-col gap-8">
                        {post.content.map(block => (
                            <section class="flex flex-col gap-4">
                                {block.heading && <h2 class="text-2xl font-semibold tracking-tight m-0">{block.heading}</h2>}
                                {block.paragraphs.map(text => (
                                    <p class="text-ink-soft leading-relaxed m-0">{text}</p>
                                ))}
                                {block.bullets && block.bullets.length > 0 && (
                                    <ul role="list" class="list-disc pl-5 text-ink-soft m-0 flex flex-col gap-2">
                                        {block.bullets.map(item => <li>{item}</li>)}
                                    </ul>
                                )}
                            </section>
                        ))}
                    </div>

                    <div class="mt-10 pt-6 border-t border-line flex flex-wrap items-center gap-3">
                        <a href="/blog" class="btn" data-variant="secondary">Back to journal</a>
                        <a href="/collections/all" class="btn">Shop latest arrivals</a>
                    </div>
                </article>

                {related.length > 0 && (
                    <section class="mt-14 md:mt-18" aria-labelledby="related-articles">
                        <h2 id="related-articles" class="text-2xl font-semibold tracking-tight mb-6">Related articles</h2>
                        <ul role="list" class="grid md:grid-cols-3 gap-6">
                            {related.map(item => (
                                <li>
                                    <BlogCard post={item} />
                                </li>
                            ))}
                        </ul>
                    </section>
                )}
            </>
        ) : (
            <EmptyState
                title="Article not found"
                text="The journal article you requested is unavailable. Explore the latest stories or continue shopping from the main catalog."
                image="/images/placeholder.png"
                actionHref="/blog"
                actionLabel="View all articles"
                secondaryHref="/collections/all"
                secondaryLabel="Shop the catalog"
            />
        )}
    </div>

    {articleSchema && <JsonLd slot="structured-data" data={articleSchema} />}
</Layout>
