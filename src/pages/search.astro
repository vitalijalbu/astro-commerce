---
import Layout from '@components/layout.astro'
import { parsePageParam } from '@lib/paginate'
import SearchResults from '@snippets/search-results.astro'
import SkeletonProductGrid from '@snippets/skeleton-product-grid.astro'


const params = Astro.url.searchParams
const query = (params.get('q') || '').trim()
const sort = params.get('sort') || 'relevance'
const page = parsePageParam(params.get('page'))

const selectedVendors = [...new Set(params.getAll('vendor').filter(Boolean))]
const onlyAvailable = params.get('available') === '1'

const parsePrice = (value: string | null): number | null => {
    if (!value) return null
    const parsed = Number(value)
    return Number.isFinite(parsed) && parsed >= 0 ? parsed : null
}

const minPrice = parsePrice(params.get('min'))
const maxPrice = parsePrice(params.get('max'))
---

<Layout title={query ? `Search: ${query} — ATELIER` : 'Search — ATELIER'} noindex>
    <div class="page py-12 md:py-16">
        <div class="mx-auto max-w-2xl text-center mb-12 md:mb-16">
            <h1 class="text-3xl md:text-5xl font-semibold tracking-tight m-0">Search</h1>
            <p class="text-muted mt-3 mb-0">Find products by name, brand or category.</p>

            <form action="/search" method="get" class="mt-6 flex gap-2" role="search" aria-label="Catalog search">
                <div class="flex-1">
                    <input class="input" type="search" name="q" value={query} placeholder="Search products…" aria-label="Search products" autofocus />
                </div>
                <button type="submit" class="btn">Search</button>
            </form>
        </div>

        <SearchResults
            query={query}
            sort={sort}
            page={page}
            selectedVendors={selectedVendors}
            onlyAvailable={onlyAvailable}
            minPrice={minPrice}
            maxPrice={maxPrice}
            search={params.toString()}
            server:defer
        >
            <div slot="fallback" class="grid lg:grid-cols-[280px_1fr] gap-8 items-start" aria-hidden="true">
                <aside class="hidden lg:block rounded-[--radius-card] border border-line bg-paper-soft p-5 md:p-6 h-fit">
                    <div class="flex flex-col gap-4">
                        <div class="h-5 w-1/2"><div class="skeleton h-full w-full"></div></div>
                        <div class="h-9 w-full"><div class="skeleton h-full w-full"></div></div>
                        <div class="h-9 w-full"><div class="skeleton h-full w-full"></div></div>
                        <div class="h-9 w-full"><div class="skeleton h-full w-full"></div></div>
                    </div>
                </aside>
                <SkeletonProductGrid count={6} columns={3} />
            </div>
        </SearchResults>
    </div>
</Layout>
