---
/**
 * Homepage — rendered entirely from the page-builder section list.
 *
 * Every section is present and statically defined here today, but the data
 * shape matches Statamic's output, so the order/content can later be driven
 * by the CMS without touching this page.
 */
import Layout from '@components/layout.astro'
import SectionRenderer from '@components/section-renderer.astro'
import { homepageSections } from '@lib/sections'
---

<Layout>
    <SectionRenderer sections={homepageSections} />
</Layout>
