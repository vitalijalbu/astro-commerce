---
import Layout from '@components/layout.astro'
import { login, requireGuest } from '@lib/auth'
import { Alert } from '@/components/ui/alert'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'

const guard = requireGuest(Astro)
if (guard) return guard

let error: string | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const email = String(form.get('email') || '')
    const password = String(form.get('password') || '')
    const remember = form.get('remember') === 'on'
    const result = await login(Astro, email, password, remember)
    if (result.ok) return Astro.redirect(Astro.url.searchParams.get('redirect') || '/account')
    error = result.error === 'invalid_credentials'
        ? 'Email or password is incorrect.'
        : 'Could not sign you in. Please try again.'
}
---

<Layout title="Sign in — ATELIER">
    <div class="page py-16 md:py-24 flex justify-center">
        <div class="w-full max-w-md">
            <h1 class="text-3xl font-semibold tracking-tight text-center mb-2">Welcome back</h1>
            <p class="text-center text-ink-soft mb-8">Sign in to your account to continue.</p>

            {error && <div class="mb-4"><Alert variant="destructive">{error}</Alert></div>}

            <form method="post" class="flex flex-col gap-4">
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Email
                    <Input type="email" name="email" placeholder="you@example.com" required {...{ autocomplete: 'email' }} />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Password
                    <Input type="password" name="password" placeholder="••••••••" required {...{ autocomplete: 'current-password' }} />
                </label>
                <div class="flex items-center justify-between">
                    <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
                        <input type="checkbox" name="remember" role="checkbox" data-slot="checkbox" />
                        Remember me
                    </label>
                    <a href="/account/recover" class="text-sm link-underline">Forgot password?</a>
                </div>
                <Button type="submit" class="w-full">Sign in</Button>
            </form>

            <p class="text-center text-sm text-ink-soft mt-6">
                New here? <a href="/register" class="link-underline font-medium">Create an account</a>
            </p>
            <p class="text-center text-xs text-muted-foreground mt-4">
                Demo: any email + password <code>demo1234</code>
            </p>
        </div>
    </div>
</Layout>
