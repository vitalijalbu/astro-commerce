---
import Layout from '@components/layout.astro'
import { register, requireGuest } from '@lib/auth'

const guard = requireGuest(Astro)
if (guard) return guard

let error: string | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const firstName = String(form.get('firstName') || '')
    const lastName = String(form.get('lastName') || '')
    const email = String(form.get('email') || '')
    const password = String(form.get('password') || '')

    if (password.length < 8) {
        error = 'Password must be at least 8 characters.'
    } else {
        const result = await register(Astro, { firstName, lastName, email, password })
        if (result.ok) return Astro.redirect('/account')
        error = 'Could not create your account. Please try again.'
    }
}
---

<Layout title="Create account — ATELIER">
    <div class="page py-16 md:py-24 flex justify-center">
        <div class="w-full max-w-md">
            <h1 class="text-3xl font-semibold tracking-tight text-center mb-2">Create your account</h1>
            <p class="text-center text-ink-soft mb-8">Faster checkout, order history and saved details.</p>

            {error && (
                <div class="mb-4" role="alert">
                    <div class="alert" data-variant="destructive">{error}</div>
                </div>
            )}

            <form method="post" class="flex flex-col gap-4">
                <div class="grid grid-cols-2 gap-4">
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        First name
                        <input name="firstName" required autocomplete="given-name" class="input" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Last name
                        <input name="lastName" required autocomplete="family-name" class="input" />
                    </label>
                </div>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Email
                    <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="input" />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Password
                    <input type="password" name="password" placeholder="At least 8 characters" required autocomplete="new-password" class="input" minlength={8} aria-describedby="password-hint" />
                    <span id="password-hint" class="text-xs text-muted-foreground">At least 8 characters.</span>
                </label>
                <label class="checkbox">
                    <input type="checkbox" name="newsletter" />
                    <span>Email me about new arrivals and offers</span>
                </label>
                <button type="submit" class="btn w-full">Create account</button>
            </form>

            <p class="text-center text-sm text-ink-soft mt-6">
                Already have an account? <a href="/login" class="link-underline font-medium">Sign in</a>
            </p>
        </div>
    </div>
</Layout>
