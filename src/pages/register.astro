---
import Layout from '@components/layout.astro'
import { register, requireGuest } from '@lib/auth'
import { Alert } from '@/components/ui/alert'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'

const guard = requireGuest(Astro)
if (guard) return guard

let error: string | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const firstName = String(form.get('firstName') || '')
    const lastName = String(form.get('lastName') || '')
    const email = String(form.get('email') || '')
    const password = String(form.get('password') || '')

    if (password.length < 8) {
        error = 'Password must be at least 8 characters.'
    } else {
        const result = await register(Astro, { firstName, lastName, email, password })
        if (result.ok) return Astro.redirect('/account')
        error = 'Could not create your account. Please try again.'
    }
}
---

<Layout title="Create account — ATELIER">
    <div class="page py-16 md:py-24 flex justify-center">
        <div class="w-full max-w-md">
            <h1 class="text-3xl font-semibold tracking-tight text-center mb-2">Create your account</h1>
            <p class="text-center text-ink-soft mb-8">Faster checkout, order history and saved details.</p>

            {error && <div class="mb-4"><Alert variant="destructive">{error}</Alert></div>}

            <form method="post" class="flex flex-col gap-4">
                <div class="grid grid-cols-2 gap-4">
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        First name
                        <Input name="firstName" required {...{ autocomplete: 'given-name' }} />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium">
                        Last name
                        <Input name="lastName" required {...{ autocomplete: 'family-name' }} />
                    </label>
                </div>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Email
                    <Input type="email" name="email" placeholder="you@example.com" required {...{ autocomplete: 'email' }} />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium">
                    Password
                    <Input type="password" name="password" placeholder="At least 8 characters" required {...{ autocomplete: 'new-password' }} />
                    <span class="text-xs text-muted-foreground">At least 8 characters</span>
                </label>
                <label class="inline-flex items-center gap-2 text-sm text-ink-soft">
                    <input type="checkbox" name="newsletter" role="checkbox" data-slot="checkbox" />
                    Email me about new arrivals and offers
                </label>
                <Button type="submit" class="w-full">Create account</Button>
            </form>

            <p class="text-center text-sm text-ink-soft mt-6">
                Already have an account? <a href="/login" class="link-underline font-medium">Sign in</a>
            </p>
        </div>
    </div>
</Layout>
